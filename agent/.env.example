# [AI Agent 활성화 모델 설정]
# Primary: OpenAI (기본)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4.1

# Fallback: Gemini (OpenAI 장애 시 자동 전환)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash

# 다중 키 사용 시 아래와 같이 추가 가능 (자동 인식)
# GEMINI_API_KEY_2=your_gemini_key_2
# OPENAI_API_KEY_2=your_openai_key_2

# [향후 확장] Anthropic (비활성화)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# LiteLLM Configuration
# LITELLM_LOGGING=True

# Redis (Memory/Caching - Optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Neo4j Graph DB
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# MySQL (superplatform_meta) — 학급/검사/상담/메모/생기부 조회용 (mysql_tools.py)
# 반드시 SELECT 권한만 부여된 읽기 전용 계정을 사용할 것 (운영 요구사항, GRANT는 DB 운영팀 책임)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your_readonly_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=superplatform_meta

# FastAPI Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# [Agent 오케스트레이션 백엔드]
# legacy: 기존 수작업 ReAct 루프(MetaAgentService, 기본값)
# langgraph: LangGraph StateGraph 기반 구현(LangGraphAgentService)
# 프로세스 기동 시 1회만 평가되므로 전환 시 재시작 필요.
# 참고: agent/docs/LANGGRAPH_MIGRATION_PLAN.md
AGENT_BACKEND=legacy

# [LangSmith Observability]
# 활성화: LANGSMITH_TRACING=true, 비활성화: false 또는 변수 미설정
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
# ENV 값에 따라 프로젝트명이 자동 구성됨: meta-dashboard-agent-{ENV}
# 예) dev -> meta-dashboard-agent-dev / prod -> meta-dashboard-agent-prod
LANGSMITH_ENV=dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
