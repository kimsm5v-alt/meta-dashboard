{
  "name": "frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "frontend/src",
  "targets": {
    "build": {
      "command": "npm run build",
      "options": {
        "cwd": "frontend"
      }
    },
    "serve": {
      "command": "npm run dev",
      "options": {
        "cwd": "frontend"
      }
    },
    "lint": {
      "command": "npm run lint",
      "options": {
        "cwd": "frontend"
      }
    },
    "type-check": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "frontend"
      }
    },
    "preview": {
      "command": "npm run preview",
      "options": {
        "cwd": "frontend"
      }
    }
  }
}
