# Kong 게이트웨이 경유 (운영) — dev(t-gw)와 동일 패턴, 게이트웨이가 /v1/meta strip 후 백엔드 전달
VITE_API_URL=https://gw.vsaidt.com/v1/meta
# AI 에이전트 (챗/스트림 중계서버, 세션 리셋 DELETE)
VITE_CHAT_API_URL=https://dj.vsaidt.com
VITE_AGENT_API_URL=https://meta-agent-api.vsaidt.com

# SuperPlatform Auth (SSO) — 운영은 vschool.at 미전환, superplatform 운영 도메인 사용
VITE_SP_SDK_URL=https://cdn.vsaidt.com/superplatform/auth-client.js
VITE_SP_AUTH_URL=https://auth-superplatform-api.vsaidt.com
VITE_SP_CLIENT_ID=meta
VITE_SP_MYPAGE_URL=https://mypage-superplatform.vsaidt.com

# QCH 로그 적재
VITE_ENABLE_QCH_LOGGING=true
VITE_QCH_BASE_URL=https://t-qch.vsaidt.com
VITE_QCH_SERVICE_KEY=meta-service-fe
VITE_QCH_ENV=prod