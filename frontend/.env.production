# meta API 는 콩(GW) 경유 — dev 와 동일. agent 는 직접(비게이트웨이) 유지.
VITE_API_URL=https://gw.vschool.at/v1/meta
VITE_AGENT_API_URL=https://meta-agent-api.vsaidt.com
VITE_CHAT_API_URL=https://dj.vsaidt.com
# SuperPlatform Auth (SSO) — vschool.at 이전. auth 는 콩(GW) 경유, SDK/mypage 는 직접.
VITE_SP_AUTH_URL=https://gw.vschool.at/v1/auth
VITE_SP_SDK_URL=https://cdn.vschool.at/sdk/auth-client.js
VITE_SP_CLIENT_ID=meta
VITE_SP_MYPAGE_URL=https://hub.vschool.at

# 자기조절학습검사 숨김 (HSJ-103: 운영서버 전용)
VITE_SELFREG_HIDDEN=true

# 교사용 설명서 PDF (HSJ-102)
VITE_MANUAL_URL_COMPREHENSIVE=https://cdn.vschool.at/meta/form/%EB%B9%84%EC%83%81%EA%B5%90%EC%9C%A1_%ED%95%99%EC%8A%B5%EC%A2%85%ED%95%A9%EA%B2%80%EC%82%AC_%EA%B5%90%EC%82%AC%EC%9A%A9_%EC%84%A4%EB%AA%85%EC%84%9C.pdf
VITE_MANUAL_URL_SELF_REGULATED=https://cdn.vschool.at/meta/form/%EB%B9%84%EC%83%81%EA%B5%90%EC%9C%A1_%EC%9E%90%EA%B8%B0%EC%A1%B0%EC%A0%88%ED%95%99%EC%8A%B5%EA%B2%80%EC%82%AC_%EA%B5%90%EC%82%AC%EC%9A%A9_%EC%84%A4%EB%AA%85%EC%84%9C.pdf

# QCH 로그 적재
VITE_ENABLE_QCH_LOGGING=true
VITE_QCH_BASE_URL=https://qch.vsaidt.com
VITE_QCH_SERVICE_KEY=meta-service-fe

# everyCanvas Embed App / 정적 SDK 오리진
VITE_EVERYCLASS_EMBED_BASE_URL=https://everyclass.vsaidt.com
# superplatform-lms API 게이트웨이 기본 URL
VITE_SP_LMS_API_URL=https://gw.vschool.at/v1/lms

# 환경 구분
VITE_ENV=prod
