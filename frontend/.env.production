# 직접(비게이트웨이) — Kong CORS(Allow-Headers) 수정 완료되면 https://t-gw.vsaidt.com/v1/meta 로 전환
VITE_API_URL=https://t-meta-api.vsaidt.com

# SuperPlatform Auth (SSO)
VITE_SP_AUTH_URL=https://t-auth-superplatform-api.vsaidt.com
