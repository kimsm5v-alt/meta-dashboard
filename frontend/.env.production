# meta API 는 콩(GW) 경유 — dev 와 동일. agent 는 직접(비게이트웨이) 유지.
VITE_API_URL=https://gw.vschool.at/v1/meta
VITE_AGENT_API_URL=https://meta-agent-api.vsaidt.com
# SuperPlatform Auth (SSO) — vschool.at 이전. auth 는 콩(GW) 경유, SDK/mypage 는 직접.
VITE_SP_AUTH_URL=https://gw.vschool.at/v1/auth
VITE_SP_SDK_URL=https://cdn.vschool.at/sdk/auth-client.js
VITE_SP_CLIENT_ID=meta
VITE_SP_MYPAGE_URL=https://hub.vschool.at

# QCH 로그 적재
VITE_ENABLE_QCH_LOGGING=true
VITE_QCH_BASE_URL=https://qch.vsaidt.com
VITE_QCH_SERVICE_KEY=meta-service-fe
VITE_QCH_ENV=prod
