    </edge>
    <edge id="e_13" source="자원소진형" target="MOD_자원소진형_13_시험준비_반감-냉소">
      <data key="e4">HAS_MODERATION_PATH</data>
    </edge>
    <edge id="e_14" source="자원소진형" target="MOD_자원소진형_14_무능감_부모 공부부담">
