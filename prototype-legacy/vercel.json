{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/dgnss/:path*", "destination": "https://t-vcloudapi.vsaidt.com/api/dgnss/:path*" },
    { "source": "/api/counseling/:path*", "destination": "https://t-vcloudapi.vsaidt.com/api/counseling/:path*" },
    { "source": "/api/memos/:path*", "destination": "https://t-vcloudapi.vsaidt.com/api/memos/:path*" },
    { "source": "/member/:path*", "destination": "https://t-vcloudapi.vsaidt.com/member/:path*" },
    { "source": "/group/:path*", "destination": "https://t-vcloudapi.vsaidt.com/group/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
