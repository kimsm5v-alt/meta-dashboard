{
  "name": "prototype-legacy",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "prototype-legacy/src",
  "targets": {
    "build": {
      "command": "npm run build",
      "options": {
        "cwd": "prototype"
      }
    },
    "serve": {
      "command": "npm run dev",
      "options": {
        "cwd": "prototype"
      }
    },
    "lint": {
      "command": "npm run lint",
      "options": {
        "cwd": "prototype"
      }
    }
  }
}
