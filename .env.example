# ============================================================
# META Dashboard 환경 변수 설정
# ============================================================
#
# 사용 방법:
# 1. 이 파일을 복사하여 '.env' 파일로 저장
# 2. 각 항목에 실제 값을 입력
# 3. .env 파일은 절대 Git에 커밋하지 마세요!
#
# ============================================================

# ------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------
# Google AI Studio에서 API Key 발급: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 설정 (선택사항)
# 기본값: gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# 백엔드 API 설정
# ------------------------------------------------------------
# API 사용 여부 (true: 백엔드 API 사용, false: Mock 데이터 사용)
VITE_USE_API=true

# API Base URL
# 테스트: https://t-vcloudapi.vsaidt.com
# 운영: https://vcloudapi.vsaidt.com
VITE_API_BASE_URL=https://t-vcloudapi.vsaidt.com

# ------------------------------------------------------------
# 테스트 계정 설정
# ------------------------------------------------------------
# public/test-accounts.json 파일에서 관리
# (JWT 토큰은 12시간마다 갱신 필요)
