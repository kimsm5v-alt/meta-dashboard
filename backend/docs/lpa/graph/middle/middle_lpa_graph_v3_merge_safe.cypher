MERGE (n:Factor {id: '자율성'}) SET n += {name: '자율성', factor_type: 'positive', factor_type_ko: '정적요인', op_def: '자기 스스로의 원칙에 따라 어떤 일을 주체적으로 결정하는 특성', mean_mid: 3.649, sd_mid: 0.925, need_score_direction: 'lower_T_worse', id: '자율성', section_1: '긍정적 공부마음', section_2: '성장력', section_nm_full: '긍정적 공부마음>성장력>자율성', env_type: '', badge_red_threshold: 'T ≤ 29', badge_orange_threshold: 'T 30~39', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:Factor {id: '유능성'}) SET n += {name: '유능성', factor_type: 'positive', factor_type_ko: '정적요인', op_def: '어떤 일을 남들보다 잘하는 능력이 있다는 느낌', mean_mid: 3.66, sd_mid: 0.945, need_score_direction: 'lower_T_worse', id: '유능성', section_1: '긍정적 공부마음', section_2: '성장력', section_nm_full: '긍정적 공부마음>성장력>유능성', env_type: '', badge_red_threshold: 'T ≤ 29', badge_orange_threshold: 'T 30~39', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:Factor {id: '관계성'}) SET n += {name: '관계성', factor_type: 'positive', factor_type_ko: '정적요인', op_def: '사람들 사이에서 관심을 주고 받으며, 그 속에서 소속감을 느끼는 정도', mean_mid: 3.942, sd_mid: 0.899, need_score_direction: 'lower_T_worse', id: '관계성', section_1: '긍정적 공부마음', section_2: '성장력', section_nm_full: '긍정적 공부마음>성장력>관계성', env_type: '', badge_red_threshold: 'T ≤ 29', badge_orange_threshold: 'T 30~39', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:Factor {id: '고갈'}) SET n += {name: '고갈', factor_type: 'negative', factor_type_ko: '부적요인', op_def: '공부 때문에 지쳐서 아무 즐거움이나 흥미가 없는 피로 상태', mean_mid: 3.311, sd_mid: 0.993, need_score_direction: 'higher_T_worse', id: '고갈', section_1: '부정적 공부마음', section_2: '학업소진', section_nm_full: '부정적 공부마음>학업소진>고갈', env_type: '', badge_red_threshold: 'T >= 70', badge_orange_threshold: 'T 60~69', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:Factor {id: '무능감'}) SET n += {name: '무능감', factor_type: 'negative', factor_type_ko: '부적요인', op_def: '노력해도 성적이 만족스럽지 않고, 노력한만큼 좋은 결과가 나오지 않아 실망감을 느끼는 상태', mean_mid: 2.653, sd_mid: 1.126, need_score_direction: 'higher_T_worse', id: '무능감', section_1: '부정적 공부마음', section_2: '학업소진', section_nm_full: '부정적 공부마음>학업소진>무능감', env_type: '', badge_red_threshold: 'T >= 70', badge_orange_threshold: 'T 60~69', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:Factor {id: '반감-냉소'}) SET n += {name: '반감-냉소', factor_type: 'negative', factor_type_ko: '부적요인', op_def: '공부 흥미가 줄거나 하기 싫다고 느끼며, 공부의 필요성을 느끼지 못하는 정도', mean_mid: 3.308, sd_mid: 1.15, need_score_direction: 'higher_T_worse', id: '반감-냉소', section_1: '부정적 공부마음', section_2: '학업소진', section_nm_full: '부정적 공부마음>학업소진>반감-냉소', env_type: '', badge_red_threshold: 'T >= 70', badge_orange_threshold: 'T 60~69', badge_gray_threshold: 'T ≥ 38'};
MERGE (n:MediationPath {id: 'MED_냉소적 무기력형_성장마인드셋_유능성'}) SET n += {lpa_class: '냉소적 무기력형', path_type: 'mediation', x: '성장마인드셋', m: '유능성', y: '학업성취도', interpretation: '성장마인드셋이 유능성으로 전환될 때 학업성취로 이어지는 경향이 있습니다. 무기력형은 신념은 있으나 실행 경험이 부족하여 유능감 형성이 지연되므로 작은 성공 경험에 대한 즉각적 피드백이 필수적입니다. 중등 시기에는 추상적 신념을 구체적 행동으로 전환하는 능력이 아직 약할 수 있으므로 구체적 행동전략 도구가 함께 제공되어야 합니다.', strategy: '아주 작은 과제부터 시작하여 즉각적 성공 경험을 제공합니다. 예를 들어 5분 안에 풀 수 있는 3문제부터 시작하게 합니다. 성공 후에는 네가 집중해서 끝까지 풀었기 때문이라고 과정 중심 피드백을 제공합니다. 성공 일지를 매일 기록하게 하고 노트에 나는 할 수 있다의 증거를 축적하도록 유도합니다. 타이머를 활용해 10분 집중 후 2분 휴식처럼 실행력을 구조화합니다.', id: 'MED_냉소적 무기력형_성장마인드셋_유능성'};
MERGE (n:MediationPath {id: 'MED_정서조절 취약형_수업태도_노트하기'}) SET n += {lpa_class: '정서조절 취약형', path_type: 'mediation', x: '수업태도', m: '노트하기', y: '학업성취도', interpretation: '수업에 참여하는 태도가 노트하기라는 구체적 행동으로 전환될 때 학업성취로 연결되는 경향이 있습니다. 정서조절 취약형은 성적 압력과 부모 교사 압력이 높아 주의집중이 분산되기 쉬우므로 노트는 주의의 닻 역할을 합니다. 중등 특성상 타인 정서 인식은 양호하나 자기 정서조절이 부족하므로 노트 필기가 정서를 행동으로 전환하는 조절 도구로 작용합니다.', strategy: '노트 필기 양식을 제공해 구조화된 참여를 유도합니다. 예를 들어 코넬 노트 형식으로 핵심 세부 요약을 구분합니다. 수업 중 지금 중요한 부분이니 노트에 표시하자고 주의 신호를 주고 수업 후 오늘 노트에서 가장 중요한 3줄은 무엇인지 질문하며 점검합니다. 정서 스트레스가 높을 때는 1분 심호흡 후 노트를 다시 보게 하여 안정화 전략을 제공합니다. 주간 노트 점검을 통해 학습 연속성을 강화합니다.', id: 'MED_정서조절 취약형_수업태도_노트하기'};
MERGE (n:MediationPath {id: 'MED_자기주도 몰입형_DIRECT_자기정서조절'}) SET n += {lpa_class: '자기주도 몰입형', path_type: 'direct', m: '자기정서조절', y: '학업성취도', interpretation: '자기주도 몰입형은 이미 자원과 전략이 우수하여 직접적으로 학업성취로 연결되는 강점형입니다. 자율성 유능성 관계성이 모두 높고 시간관리와 정서 안정이 우수하므로 교사의 역할은 과도한 개입을 피하고 도전적 환경을 제공하는 것입니다. 중등 시기에는 정체성 탐색 욕구가 강하므로 자율성 존중과 또래 협력을 통해 사회적 강점을 학습자원으로 전환할 수 있습니다.', strategy: '선택권을 부여하고 현재 수준보다 약간 높은 도전적 과제를 제공하여 몰입을 유지합니다. 협력학습 구조를 활용해 관계성을 학습자원으로 전환하고 어떤 전략이 효과적이었는지 묻는 메타인지 대화를 통해 자기점검 루프를 강화합니다. 교사는 2주 1회 정도의 체크포인트만 제공하고 일상적 모니터링은 최소화하여 자율성을 보장합니다.', id: 'MED_자기주도 몰입형_DIRECT_자기정서조절'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_1_교사 정서지지_게임 과몰입'}) SET n += {lpa_class: '냉소적 무기력형', x: '교사 정서지지', z: '게임 과몰입', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '교사의 정서적 지지가 있고 게임에 과몰입하는 학생에게, 지지가 조절 동력이 되어 게임 시간을 줄이고 학업성취가 증가합니다. 냉소적 무기력형은 게임 과몰입이 높은 상태이므로, 교사 지지를 조절 계약으로 전환하고 대체 보상을 제공해야 합니다.', strategy: '\'관계 지지 + 조절 계약\' 전략을 도입합니다. \'선생님이 응원하니까 이번 주는 게임 30분 줄여보자. 대신 10분만 공부하고 나머지는 자유시간\'이라며 작은 조절 + 대체 보상을 제공합니다. 주 1회 \'조절 체크인\'(게임 시간 기록)으로 지속적 지지를 제공하고, 조절 성공 시 \'네가 게임 줄였네. 대단해\'라며 관계적 보상을 제공합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_1_교사 정서지지_게임 과몰입'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_2_부모 공부부담_계획능력'}) SET n += {lpa_class: '냉소적 무기력형', x: '부모 공부부담', z: '계획능력', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '부모의 공부 압박이 있는 상황에서 계획을 잘 세우는 능력이 있으면, 계획이 압박을 관리하는 도구가 되어 주도감을 회복하며 학업성취가 증가합니다. 냉소적 무기력형은 부모 압박이 높고 계획 능력이 부족하므로, 작은 계획부터 시작하고 학생 주도 소통을 유도해야 합니다.', strategy: '\'학생 주도 계획 + 부모 협력\' 전략을 도입합니다. \'주간 계획 시트\'를 학생이 작성하게 하고, \'이걸 부모님께 보여주고 \'이번 주는 이렇게 할게요\'라고 말해봐\'라며 학생 주도 소통을 유도합니다. 부모에게는 \'학생이 계획을 세웠으면 인정해주세요. 수정은 학생이 요청할 때만\'이라며 지지 역할을 안내합니다. 주 1회 \'이번 주 네가 계획하고 실행했네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_2_부모 공부부담_계획능력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_3_몰두_고갈'}) SET n += {lpa_class: '냉소적 무기력형', x: '몰두', z: '고갈', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '학습에 몰입하는 경험이 있고 심리적으로 고갈된 상태일 때, 몰입이 회복 동력이 되어 학업성취가 증가합니다. 냉소적 무기력형은 몰입 경험 부족과 고갈이 모두 높은 상태이므로, 회복 시간 확보 + 짧은 몰입 경험을 병행해야 합니다.', strategy: '\'회복 + 짧은 몰입\' 전략을 도입합니다. \'이번 주는 쉬고, 다음 주부터 5분만 집중\'이라며 회복 우선을 안내합니다. 회복 후 \'5분 타이머로 집중\'을 유도하고, 성공 후 \'5분 집중했네. 회복하면서도 할 수 있어\'라며 피드백합니다. 주 1회 \'이번 주 회복하고 집중했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_3_몰두_고갈'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_4_자기정서인식_공부부담'}) SET n += {lpa_class: '냉소적 무기력형', x: '자기정서인식', z: '공부부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '자신의 감정을 잘 아는 학생이 공부 부담이 크면, 부담 정서를 명확히 인식하여 오히려 회피(\'너무 힘들다는 걸 알아. 못 하겠어\')가 강화되고 학업성취가 감소합니다. 냉소적 무기력형은 정서인식은 양호하나 부담이 높은 상태이므로, 정서를 행동으로 전환하는 훈련이 필요합니다. 중등 시기 정서 민감도가 높으므로, 정서를 학습 동기로 연결하는 것이 핵심입니다.', strategy: '\'정서 재해석 + 부담 분할\' 전략을 도입합니다. \'지금 힘들다는 걸 아는 게 좋은 거야. 그럼 오늘은 5분만 해보자. 힘들 때는 멈춰도 돼\'라며 정서를 인정하고 부담을 분할합니다. \'정서-행동 일지\'(오늘 감정 + 그 상태에서 시도한 것 1개)를 작성하게 하고, \'힘들어도 5분 시도한 게 대단해\'라며 정서 속 행동을 인정합니다. 주 1회 \'이번 주 힘든 상태에서도 시도했네. 대단해\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_4_자기정서인식_공부부담'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_5_조절능력_공부환경'}) SET n += {lpa_class: '냉소적 무기력형', x: '조절능력', z: '공부환경', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '조절능력이 좋을수록 공부환경도 함께 잘 갖추는 경향이 있습니다. 이 유형은 의지로 버티기보다 ‘환경이 도와주면’ 조절이 훨씬 쉬워집니다. 반대로 환경이 흐트러지면(폰/잡음/자리) 조절능력이 있어도 쉽게 무너질 수 있어, 환경을 ‘조절의 스위치’로 쓰는 것이 핵심입니다.', strategy: '“2분 환경 세팅”을 시작 루틴으로 고정합니다(책상 비우기/필요물 3개/타이머 켜기/폰 보관). 교사는 “환경은 준비가 아니라 시작 버튼”이라고 안내하고, 세팅이 길어지면 “세팅 중단→첫 문제 1개”로 바로 실행시킵니다. 환경이 잘 갖춰진 날엔 “오늘은 환경을 잘 만들어서 조절이 쉬웠다”처럼 환경-조절 연결을 말로 붙여줍니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_5_조절능력_공부환경'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_6_수업부담_관계성'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '관계성', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '수업이 부담스러운 상황에서 관계성이 있어도, 관계가 부담 회피를 정당화하여 학업성취가 감소합니다. 냉소적 무기력형은 수업 부담이 높고 관계성에 의존하므로, 부담 경감 + 관계를 학습자원으로 전환해야 합니다.', strategy: '\'부담 경감 + 협력 학습\' 전략을 도입합니다. 수업 부담을 \'오늘은 2문제만\'으로 줄이고, \'모둠 활동\'(역할 분담)으로 관계성을 학습자원으로 전환합니다. \'친구들과 함께 하니까 부담이 줄지?\'라며 관계-부담 완화를 명시합니다. 주 1회 \'이번 주 친구들과 함께 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_6_수업부담_관계성'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_7_친구 정서지지_교사 성적압력'}) SET n += {lpa_class: '냉소적 무기력형', x: '친구 정서지지', z: '교사 성적압력', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '친구의 정서적 지지가 있어도 교사의 성적 압력이 크면, 지지가 압력 회피를 정당화하여 학업성취가 감소합니다. 냉소적 무기력형은 친구 지지에 의존하면서 성적 압력을 회피하므로, 압력 경감 + 지지를 협력으로 전환해야 합니다.', strategy: '\'압력 경감 + 협력 학습\' 전략을 도입합니다. 성적 압력을 \'오늘은 3문제만 풀면 OK. 성적 걱정 말고 과정만 집중\'처럼 과정 목표로 전환합니다. 친구 지지를 \'짝과 함께 1문제씩 풀기\'로 실행화하고, \'친구가 응원하는 건 \'같이 하자\'는 뜻이야\'라며 지지를 협력으로 재구성합니다. 주 1회 \'이번 주 성적 걱정 없이 친구와 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_7_친구 정서지지_교사 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_8_타인정서인식_교사 수업부담'}) SET n += {lpa_class: '냉소적 무기력형', x: '타인정서인식', z: '교사 수업부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '타인의 정서를 잘 읽는 학생이 교사의 수업 부담을 크게 느끼면, 교사의 부담 신호를 포착하여 더 위축되고 학업성취가 감소합니다. 냉소적 무기력형은 타인정서인식은 양호하나 수업 부담이 높은 상태이므로, 부담 경감 + 긍정 신호 제공이 필요합니다. 중등 시기 또래 평가 민감도가 높으므로, 교사의 긍정 신호가 핵심입니다.', strategy: '\'긍정 신호 + 부담 경감\' 전략을 도입합니다. 수업 시작 시 \'오늘은 편하게 해도 돼. 천천히 해보자\'라며 안전한 분위기를 조성합니다. 학생이 시도할 때 미소, 고개 끄덕임 같은 긍정 신호를 의도적으로 보내고, 수업 후 \'아까 선생님이 웃었을 때 봤어? 네가 잘하고 있었거든\'이라며 신호를 명시적으로 해석합니다. 수업 부담을 \'오늘은 2문제만\'처럼 최소 목표로 줄이고, 주 1회 \'이번 주 편하게 잘 참여했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_8_타인정서인식_교사 수업부담'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_9_수업부담_교사 정서지지'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '교사 정서지지', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '수업 부담이 클 때, 교사의 정서적 지지(\'괜찮아, 천천히 해도 돼\')가 있으면 부담이 완화되어 학업성취가 증가합니다. 냉소적 무기력형은 실패 경험 누적으로 \'어차피 못 할 거야\'라는 학습된 무기력이 형성되어 있으므로, 교사의 비판단적 지지가 심리적 안전망 역할을 합니다. 중등 시기 또래 평가 민감도가 높아 실패 두려움이 크므로, 교사가 \'실패해도 괜찮은 공간\'을 만들어주는 것이 핵심입니다.', strategy: '\'안전한 실패 존\' 전략을 도입합니다. 수업 시작 시 \'오늘은 틀려도 괜찮은 연습 시간\'이라며 심리적 안전감을 선언합니다. 학생이 막힐 때 \'여기까지 정확해. 다음 단계만 같이 해보자\'라며 부분 성공을 즉시 인정합니다. 개별 상담 시 \'요즘 수업이 많이 힘들지? 어떤 부분이 제일 버거워?\'라며 정서를 먼저 수용하고, \'그럼 이번 주는 그 부분만 천천히 연습해보자\'라며 부담을 분할합니다. 주 1회 \'1분 체크인\'(수업 후 \'오늘 어땠어?\' 짧은 대화)으로 지속적 관계를 유지합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_9_수업부담_교사 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_10_시간관리_노트하기'}) SET n += {lpa_class: '냉소적 무기력형', x: '시간관리', z: '노트하기', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '시간을 잘 관리하는 학생이 노트 정리까지 완벽하게 하려 하면, 과도한 부담으로 실행이 지연되어 오히려 학업성취가 감소합니다. 냉소적 무기력형은 시간 관리와 노트 모두 부족한 상태이므로, 하나씩 단계적으로 훈련해야 합니다.', strategy: '\'우선순위 설정\' 전략을 도입합니다. \'이번 주는 시간 관리만 연습하자. 하루 10분만 계획하고 실행해봐\'라며 작은 목표를 제시합니다. 타이머(10분 집중)로 시간 의식을 강화하고, 노트는 \'수업 후 핵심 3줄만 적기\'로 부담을 줄입니다. \'완벽한 노트보다 실행이 우선이야. 70% 완성도로도 충분해\'라며 실행 중심 사고를 강조합니다. 주 1회 \'이번 주 시간 관리 잘했네. 다음 주는 노트도 추가해보자\'라며 점진적 확장을 안내합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_10_시간관리_노트하기'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_11_성장마인드셋_몰두'}) SET n += {lpa_class: '냉소적 무기력형', x: '성장마인드셋', z: '몰두', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '\'노력하면 발전한다\'는 신념이 있고, 학습에 몰입하는 경험까지 더해지면 실패해도 다시 시도하며 학업성취가 증가합니다. 냉소적 무기력형은 몰입 경험 부족으로 신념만으로는 행동 전환이 어려운데, 짧은 몰입 경험이 \'노력이 효과 있구나\'는 확신으로 이어집니다.', strategy: '\'5분 몰입 → 성장 확인\' 루틴을 도입합니다. \'5분 타이머 맞추고 이 문제에만 집중해보자\'라며 짧은 몰입 경험을 제공합니다. 성공 후 \'5분 집중해서 여기까지 왔잖아. 이게 노력의 결과야\'라며 몰입-성장 연결을 명시합니다. \'성장 기록 노트\'(이번 주 몰입 시간: 월 5분, 화 7분…)를 작성하게 하고, \'월요일보다 수요일이 2분 늘었네. 노력이 발전으로 이어지고 있어\'라며 가시적 성장을 보여줍니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_11_성장마인드셋_몰두'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_12_스마트폰 의존_무능감'}) SET n += {lpa_class: '냉소적 무기력형', x: '스마트폰 의존', z: '무능감', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '스마트폰에 의존하는 학생이 무능감까지 느끼면, 즉각 보상(스마트폰)이 학습 회피 수단이 되어 학업성취가 감소합니다. 냉소적 무기력형은 스마트폰 의존과 무능감 모두 높은 상태이므로, 환경 통제 + 작은 성공으로 효능감 회복을 병행해야 합니다.', strategy: '\'폰 차단 + 1분 성공\' 전략을 도입합니다. 폰은 \'10분 공부 후 2분 폰\' 규칙으로 통제하고, \'공부 시간에는 폰 보관함에 넣자\'라며 물리적 차단을 유도합니다. \'1분 안에 풀 수 있는 쉬운 문제\'로 즉각 성공 경험을 제공하고, 성공 후 \'해냈네! 네가 할 수 있잖아\'라며 효능감을 회복합니다. \'나는 할 수 있다\' 노트(매일 성공 1개 기록)로 효능감을 축적하고, 주 1회 \'이번 주 폰 없이 성공했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_12_스마트폰 의존_무능감'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_13_몰두_반감-냉소'}) SET n += {lpa_class: '냉소적 무기력형', x: '몰두', z: '반감-냉소', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '학습에 몰입하는 경험이 있고 냉소적 태도가 있을 때, 몰입이 냉소를 완화하여 학업성취가 증가합니다. 냉소적 무기력형은 몰입 경험 부족과 냉소가 모두 높은 상태이므로, 짧은 몰입 경험으로 긍정 정서를 유발하고 냉소를 완화해야 합니다.', strategy: '\'5분 몰입 + 긍정 경험\' 전략을 도입합니다. \'5분 타이머 맞추고 이 문제에만 집중해보자\'라며 짧은 몰입 경험을 제공합니다. 성공 후 \'5분 집중했잖아. \'어차피 안 돼\'가 아니라 \'할 수 있어\'가 맞는 거야\'라며 냉소를 긍정으로 재구성합니다. 주 1회 \'이번 주 집중하면서 냉소도 줄었네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_13_몰두_반감-냉소'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_14_성장마인드셋_부모 공부부담'}) SET n += {lpa_class: '냉소적 무기력형', x: '성장마인드셋', z: '부모 공부부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '\'노력하면 된다\'는 신념이 있어도 부모의 공부 압박이 크면, 압박이 신념을 무력화(\'노력해도 부모님 기대를 못 채워\')하여 학업성취가 감소합니다. 냉소적 무기력형은 신념은 있으나 부모 압박으로 실행 동력이 차단되므로, 부담 경감 + 작은 성공 경험을 병행해야 합니다.', strategy: '\'부담 분할 + 과정 강화\' 전략을 도입합니다. 부모 상담 시 \'학생이 \'노력하면 된다\'는 신념이 있습니다. 하지만 압박이 크면 신념이 무력화됩니다. \'오늘 10분 노력했네\'처럼 과정을 칭찬해주세요\'라며 과정 중심 피드백을 요청합니다. 학생에게는 \'부모님 기대 말고, 네가 오늘 노력한 것 1개만 생각해봐. 그게 성장이야\'라며 자기준거 목표를 제시합니다. 주 1회 \'이번 주 네 방식으로 노력했네. 잘했어\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_14_성장마인드셋_부모 공부부담'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_15_스마트폰 의존_부모 성적압력'}) SET n += {lpa_class: '냉소적 무기력형', x: '스마트폰 의존', z: '부모 성적압력', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '스마트폰에 의존하는 학생이 부모의 성적 압력까지 받으면, 스마트폰이 도피 수단이 되어 학습 회피가 강화되고 학업성취가 감소합니다. 냉소적 무기력형은 스마트폰 의존과 성적 압력 모두 높은 상태이므로, 환경 통제 + 압력 경감을 병행해야 합니다.', strategy: '\'환경 차단 + 과정 칭찬\' 전략을 도입합니다. 학습 시간에 폰을 물리적으로 차단(보관함)하고, \'10분 공부 후 2분 폰\'처럼 명확한 규칙을 제공합니다. 부모 상담 시 \'성적 압박보다 \'오늘 10분 집중했네\' 같은 과정 칭찬을 해주세요. 폰은 부모님이 보관해주세요\'라며 결과 압박 중단 + 물리적 차단을 요청합니다. 학생에게는 \'성적 걱정 말고, 오늘 10분만 집중해봐. 그게 목표야\'라며 과정 목표를 제시합니다. 주 1회 \'이번 주 폰 없이 집중 잘했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_15_스마트폰 의존_부모 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_16_점검능력_부모 의사소통'}) SET n += {lpa_class: '냉소적 무기력형', x: '점검능력', z: '부모 의사소통', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '스스로 학습을 점검하는 능력이 있고, 부모와의 의사소통이 원활하면 점검 결과를 부모와 공유하며 개선 방향을 찾아 학업성취가 증가합니다. 냉소적 무기력형은 점검 능력이 있어도 혼자서는 개선 동력이 부족한데, 부모와의 대화가 \'다음엔 이렇게 해보자\'는 계획으로 전환되는 계기가 됩니다. 중등 시기 독립 욕구가 강하므로, 부모 소통은 지시가 아닌 \'함께 생각하기\' 방식이어야 합니다.', strategy: '주간 점검 대화 가이드\'를 부모에게 제공합니다. \'금요일 저녁, 자녀에게 \'이번 주 공부 중 잘된 것 1가지, 아쉬운 것 1가지\'를 물어보고, \'다음 주는 어떻게 할까?\'를 함께 정해보세요\'라며 구조화된 대화 프레임을 안내합니다. 학생에게는 \'학습 점검 노트\'(매주 금요일 작성: 잘한 것, 아쉬운 것, 다음 주 계획)를 제공하고, \'이거 부모님께 보여주고 같이 이야기해봐\'라며 소통의 매개 도구로 활용합니다. 부모 상담 시 \'결과보다 점검 과정을 칭찬해주세요. \'네가 스스로 확인했구나!\'처럼요\'라며 점검 행동 강화 방법을 안내합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_16_점검능력_부모 의사소통'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_17_수업부담_부모 학업지지'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '부모 학업지지', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '수업이 힘들고 부담스러울 때, 부모의 학업 지지가 있으면 그 부담이 완화되어 학업성취가 증가합니다. 냉소적 무기력형은 \'어차피 안 돼\'라는 냉소와 자기효능감 저하로 수업 참여를 회피하는데, 부모가 결과 압력이 아닌 과정 지지(\'오늘 수업 어땠어? 힘들었구나\')를 보내면 심리적 안전감이 형성되어 수업에 다시 참여할 동력이 생깁니다. 중등 시기 정체성 탐색 욕구가 강하므로, 부모 지지는 \'독립적 시도\'를 격려하는 방향이어야 효과적입니다.', strategy: '부모 상담 시 \'3:1 피드백 원칙\'을 안내합니다. \'시험 결과보다 오늘 공부한 과정 3가지를 물어보세요. \'수학 문제 몇 개 풀었어? 어려웠어? 내일은 어떻게 할 거야?\'처럼요\'라며 과정 중심 대화 스크립트를 제공합니다. 학생에게는 \'부모님이 네 노력을 알아주실 거야. 오늘 수업에서 네가 시도한 것 1가지만 말해봐\'라며 작은 시도를 가시화합니다. 주 1회 \'부모-자녀 학습 대화 카드\'(5분 대화 주제 제공)를 가정에 보내 구조화된 지지를 유도합니다. 교사는 \'오늘 수업에서 ○○이가 질문했어요\'라는 긍정 신호를 부모에게 전달하여 지지의 근거를 마련합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_17_수업부담_부모 학업지지'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_18_몰두_성장마인드셋'}) SET n += {lpa_class: '냉소적 무기력형', x: '몰두', z: '성장마인드셋', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '학습에 몰입하는 경험이 있고, \'노력하면 발전한다\'는 신념까지 더해지면 실패해도 다시 시도하며 학업성취가 증가합니다. 냉소적 무기력형은 몰입 경험 자체가 부족하므로, 짧은 몰입(5분)부터 시작해 성장 신념과 연결해야 합니다. 중등 시기 즉각 보상(게임, 스마트폰) 경쟁이 치열하므로, 학습 몰입도 즉각 피드백이 필수입니다.', strategy: '5분 타이머 몰입 챌린지\'를 도입합니다. \'5분 동안 이 문제에만 집중해보자. 타이머 울리면 끝!\'이라며 짧은 몰입 경험을 제공합니다. 성공 후 \'5분 집중했잖아. 이게 네가 발전하는 과정이야\'라며 몰입-성장 연결 피드백을 제공합니다. \'성장 그래프\'(이번 주 몰입 시간 기록: 월 5분, 화 7분…)를 노트에 그리게 하고, \'이번 주 월요일보다 수요일이 2분 늘었네. 이게 성장이야\'라며 가시적 발전을 보여줍니다. 실패 시 \'이번엔 안 됐지만, 5분 시도한 게 대단해. 다음엔 방법을 바꿔보자\'라며 실패를 학습 기회로 재구성합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_18_몰두_성장마인드셋'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_19_무능감_성적부담'}) SET n += {lpa_class: '냉소적 무기력형', x: '무능감', z: '성적부담', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '무능감과 성적부담이 함께 높게 나타나는 경향이 있습니다. 이 조합은 “못하는데 성적은 나와야 한다”로 압박이 겹치면서 회피·포기 루프로 굳어지기 쉬운 위험 신호입니다. 냉소적 무기력형에서는 특히 ‘시작 자체’를 막아버리므로, 압박을 잠깐 내려놓고 ‘즉시 성공’을 먼저 만드는 게 우선입니다.', strategy: '레드 플래그로 즉시 개입합니다. “오늘은 점수 얘기 안 함. 목표는 성공 1개”를 선언하고, 1분 안에 끝나는 쉬운 문제 1개로 시작합니다. 성공 직후 “지금 ‘못한다’는 생각이 사실이 아니란 증거가 생겼다”라고 말로 연결합니다. 성적부담은 ‘자기준거’로 바꿔 “어제의 나보다 1개 더 하면 성공” 기준을 주고, 가정 연계가 가능하면 결과 질문 대신 과정 질문(“오늘 뭐 했어?”)만 하도록 안내합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_19_무능감_성적부담'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_20_자기효능감_수업부담'}) SET n += {lpa_class: '냉소적 무기력형', x: '자기효능감', z: '수업부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '\'나는 할 수 있다\'는 믿음이 있어도 수업 부담이 크면, 부담이 효능감을 무력화하여 학업성취가 감소합니다. 냉소적 무기력형은 효능감은 있으나 부담이 높은 상태이므로, 부담 경감 + 효능감을 행동으로 전환해야 합니다.', strategy: '\'최소 목표 + 효능감 활용\' 전략을 도입합니다. \'네가 할 수 있으니까 오늘은 1문제만 해보자. 부담 없이\'라며 효능감을 작은 행동으로 연결합니다. 성공 후 \'해냈네! 네 능력이 증명됐어\'라며 효능감-성공 피드백을 제공합니다. 주 1회 \'이번 주 부담 줄이면서 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_20_자기효능감_수업부담'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_21_타인공감능력_수업태도'}) SET n += {lpa_class: '냉소적 무기력형', x: '타인공감능력', z: '수업태도', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '친구나 교사의 감정을 잘 읽는 능력이 있고, 수업에 참여하는 태도까지 좋으면 타인의 반응을 학습 신호로 활용하며 학업성취가 증가합니다. 냉소적 무기력형은 공감 능력은 있으나 수업 참여 동력이 부족한데, 교사의 긍정 신호(\'잘하고 있어\')를 포착하면 참여가 강화됩니다. 중등 시기 또래 평가 민감도가 높으므로, 공감 능력을 긍정 피드백 수용 도구로 전환해야 합니다.', strategy: '\'신호 포착 훈련\'을 도입합니다. 수업 중 학생이 참여할 때 고개 끄덕임, 미소, \'좋아\' 같은 비언어 신호를 의도적으로 보냅니다. 수업 후 \'아까 선생님이 웃었을 때 눈치챘어? 네 답이 좋아서 그랬어\'라며 신호를 명시적으로 해석해줍니다. \'공감-참여 일지\'(오늘 수업에서 포착한 신호 1개 + 내 반응 1개)를 작성하게 하고, 주 1회 \'이번 주 네가 신호를 잘 읽고 참여했네\'라며 피드백합니다. 모둠 활동 시 \'○○가 지금 어떤 표정이야? 도움이 필요할까?\'라며 공감 능력을 협력 학습에 연결합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_21_타인공감능력_수업태도'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_22_무능감_스마트폰 의존'}) SET n += {lpa_class: '냉소적 무기력형', x: '무능감', z: '스마트폰 의존', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '\'나는 못 해\'라는 무능감이 있고 스마트폰에 의존하면, 즉각 보상(스마트폰)이 학습 회피 수단이 되어 학업성취가 감소합니다. 냉소적 무기력형은 무능감과 스마트폰 의존 모두 높은 상태이므로, 작은 성공으로 효능감 회복 + 환경 통제를 병행해야 합니다.', strategy: '\'1분 성공 + 폰 차단\' 전략을 도입합니다. \'1분 안에 풀 수 있는 쉬운 문제 1개\'로 즉각 성공 경험을 제공하고, 성공 후 \'해냈네! 네가 할 수 있잖아\'라며 효능감 회복 피드백을 제공합니다. 폰은 \'10분 공부 후 2분 폰\' 규칙으로 통제하고, \'공부 시간에는 폰 보관함에 넣자\'라며 물리적 차단을 유도합니다. \'나는 할 수 있다\' 노트(매일 성공 1개 기록)로 효능감을 축적하고, 주 1회 \'이번 주 폰 없이 성공했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_22_무능감_스마트폰 의존'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_23_노트하기_시간관리'}) SET n += {lpa_class: '냉소적 무기력형', x: '노트하기', z: '시간관리', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '노트 정리를 잘하는 학생이 시간 관리까지 완벽하게 하려 하면, 과도한 완벽주의로 실행이 지연되어 오히려 학업성취가 감소합니다. 냉소적 무기력형은 노트와 시간 관리 모두 부족한 상태이므로, 하나씩 단계적으로 훈련해야 합니다. 중등 시기 전두엽 발달 불균형으로 동시 다중 과제가 어려우므로, 우선순위 설정이 핵심입니다.', strategy: '\'하나씩 완성\' 전략을 도입합니다. \'이번 주는 노트만 집중하자. 시간 관리는 다음 주에\'라며 순차적 목표를 제시합니다. 노트 양식(코넬 노트)을 제공하여 구조화된 정리를 돕고, \'완벽하게 쓰려 하지 말고, 핵심 3줄만 적어봐\'라며 80% 완성도 원칙을 강조합니다. 시간 관리는 노트 습관이 정착된 후 \'주간 플래너 1칸만 채우기\'로 시작합니다. 주 1회 \'이번 주 노트 잘했네. 다음 주는 시간도 추가해보자\'라며 점진적 확장을 안내합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_23_노트하기_시간관리'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_24_반감-냉소_시험준비'}) SET n += {lpa_class: '냉소적 무기력형', x: '반감-냉소', z: '시험준비', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '반감·냉소가 높을수록 시험준비 방식이 ‘의미 찾기’가 아니라 ‘버티기/통과하기’로 굳어지며 함께 나타나는 경향이 있습니다. 이 유형은 “하기 싫다”가 바로 ‘안 한다’로 가지 않고, 오히려 감정은 냉소적이어도 행동은 기계적으로 유지되는 경우가 있습니다. 그래서 감정을 억지로 바꾸기보다, 준비 행동을 망치지 않도록 구조화하는 게 먼저입니다.', strategy: '감정과 행동을 분리해줍니다. “의미를 당장 찾지 않아도 돼. 오늘 목표는 통과를 위한 준비”처럼 실용 프레임을 주고, 시험준비를 ‘짧은 세트’로 고정합니다(20분 준비+5분 마무리: 오답표시/요약3줄/내일1개). 교사는 “싫어도 준비를 유지하는 게 실력”이라고 행동을 인정하고, 냉소가 올라오면 분량을 줄여도 ‘마무리만은 완료’하게 합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_24_반감-냉소_시험준비'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_25_활기_유능성'}) SET n += {lpa_class: '냉소적 무기력형', x: '활기', z: '유능성', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '에너지와 활력이 있고, \'나는 할 수 있다\'는 믿음까지 더해지면 활기를 학습 에너지로 전환하며 학업성취가 증가합니다. 냉소적 무기력형은 활기 자체가 낮고 유능감도 부족하므로, 작은 성공으로 유능감을 회복하고 활기를 유도해야 합니다. 중등 시기 또래 활동 선호가 강하므로, 협력학습으로 활기를 유발할 수 있습니다.', strategy: '\'활동 중심 학습 + 즉각 피드백\'을 도입합니다. 모둠 퀴즈(\'5분 안에 정답 찾기\')처럼 활동성 높은 과제를 제공하고, 성공 후 \'네가 적극적으로 참여해서 정답 찾았잖아. 이게 네 능력이야\'라며 활기-유능감 연결을 명시합니다. 수업 시작 시 \'1분 스트레칭 + 파이팅 구호\'로 에너지를 활성화하고, \'오늘 활력 있네. 이 에너지로 문제 풀어보자\'라며 활기를 학습에 연결합니다. 주 1회 \'이번 주 네가 활발하게 참여했네. 대단해\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_25_활기_유능성'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_26_타인정서인식_의미감'}) SET n += {lpa_class: '냉소적 무기력형', x: '타인정서인식', z: '의미감', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '타인의 정서를 잘 읽는 학생이 학습의 의미를 느낄 때, 타인 기대에 부응하려는 압박으로 자기주도성이 약화되어 오히려 학업성취가 감소합니다. 냉소적 무기력형은 타인정서인식은 양호하나 의미감이 부족하므로, 의미를 내적 기준으로 전환하는 훈련이 필요합니다.', strategy: '\'내 의미 찾기\' 전략을 도입합니다. \'이 공부가 친구나 선생님 때문이 아니라, 네 미래에 왜 필요할까?\'라며 내적 동기를 탐색합니다. \'나의 학습 이유 노트\'(이 과목이 내 꿈에 어떻게 연결되는지)를 작성하게 하고, 타인 반응보다 자기 목표를 우선하도록 안내합니다. \'친구 표정보다 네 목표가 더 중요해. 네가 왜 이걸 하는지 기억해\'라며 자기준거를 강화합니다. 주 1회 \'이번 주 네 기준으로 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_26_타인정서인식_의미감'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_27_수업부담_자기정서인식'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '자기정서인식', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '수업이 부담스러운 상황에서 자신의 감정을 잘 아는 학생은, 부담 정서를 명확히 인식하여 회피가 강화되고 학업성취가 감소합니다. 냉소적 무기력형은 수업 부담이 높고 정서인식도 양호하므로, 정서를 행동으로 전환하는 훈련이 필요합니다.', strategy: '\'정서 인정 + 부담 경감\' 전략을 도입합니다. \'지금 힘들다는 걸 아는 게 좋아. 오늘은 수업에서 2문제만 풀면 OK\'라며 정서를 인정하고 부담을 경감합니다. \'정서-행동 노트\'(오늘 감정 + 수업에서 시도 1개)를 작성하게 하고, 주 1회 \'이번 주 힘든 상태에서도 참여했네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_27_수업부담_자기정서인식'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_28_자기효능감_자기정서조절'}) SET n += {lpa_class: '냉소적 무기력형', x: '자기효능감', z: '자기정서조절', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '\'나는 할 수 있다\'는 믿음이 있고, 감정을 잘 조절하는 능력까지 더해지면 학습 상황에서 불안이나 좌절을 관리하며 지속적으로 학업성취가 증가합니다. 냉소적 무기력형은 효능감 자체가 낮은 상태이므로, 작은 성공으로 효능감을 회복하고 정서조절 기법을 병행해야 합니다. 중등 시기 전두엽 발달 불균형으로 정서 폭발이 잦으므로, 즉각 사용 가능한 조절 도구가 필요합니다.', strategy: '3-3-3 정서조절 전략\'을 가르칩니다. \'막힐 때 3초 눈 감기 → 3번 깊게 숨쉬기 → 3초 뒤 다시 시작\'이라며 즉각 실행 가능한 루틴을 제공합니다. 작은 성공 후 \'네가 포기하지 않고 끝까지 했잖아. 이게 네 능력이야\'라며 효능감-행동 연결 피드백을 제공합니다. \'정서-학습 일지\'(오늘 감정 1개 + 그 상태에서 해낸 것 1개)를 매일 기록하게 하고, 주 1회 교사가 \'이번 주 네가 불안했는데도 문제 풀었네. 대단해!\'라며 정서조절 성공을 가시화합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_28_자기효능감_자기정서조절'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_29_수업부담_자기효능감'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '자기효능감', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '수업이 부담스러운 상황에서 \'나는 할 수 있다\'는 믿음이 있어도, 부담이 효능감을 무력화(\'할 수 있는데 부담이 너무 커\')하여 학업성취가 감소합니다. 냉소적 무기력형은 효능감은 있으나 수업 부담이 높은 상태이므로, 부담 경감 + 작은 성공 경험을 병행해야 합니다.', strategy: '\'부담 분할 + 성공 경험\' 전략을 도입합니다. 수업 부담을 \'오늘은 2문제만 풀면 OK\'처럼 최소 목표로 줄이고, \'네가 할 수 있으니까 작은 것부터 해보자\'라며 효능감을 작은 행동으로 연결합니다. 성공 후 \'해냈네! 네가 할 수 있다고 했잖아. 그게 사실이야\'라며 효능감-성공 연결 피드백을 제공합니다. 주 1회 \'이번 주 부담 줄이면서 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_29_수업부담_자기효능감'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_30_자기효능감_자아존중감'}) SET n += {lpa_class: '냉소적 무기력형', x: '자기효능감', z: '자아존중감', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '자기효능감과 자아존중감은 함께 움직이는 경향이 큽니다. 이 유형은 “해낼 수 있다”가 흔들리면 “나는 별로야”까지 같이 꺼지기 쉬워, 작은 실패가 빠르게 자기평가 하락으로 번질 수 있습니다. 반대로 아주 작은 성공이 붙으면 효능감과 자존감이 같이 회복되기 시작합니다.', strategy: '성취가 아니라 ‘해낸 증거’를 매일 남기게 합니다. “정답 몇 개”보다 “오늘 한 행동 1개(시작/제출/질문/오답표시)”를 기록하고, 교사는 “네가 해낸 게 증거야”라고 행동을 콕 집어 강화합니다. 실패가 나왔을 땐 “너”가 아니라 “방법”을 바꾸는 피드백(“전략만 바꾸면 돼”)으로 자존감 손상을 막습니다. 주 2회 ‘해낸 것 3개’ 체크로 회복 루틴을 고정합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_30_자기효능감_자아존중감'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_31_수업부담_자율성'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업부담', z: '자율성', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '수업이 부담스러운 상황에서 자율성이 있어도, 부담이 자율성을 무력화하여 학업성취가 감소합니다. 냉소적 무기력형은 수업 부담이 높고 자율성도 양호하므로, 부담 경감 + 작은 선택권 제공을 병행해야 합니다.', strategy: '\'부담 경감 + 선택권\' 전략을 도입합니다. 수업 부담을 \'오늘은 2문제만\'으로 줄이고, \'수학 2문제 vs 국어 1지문, 뭐 먼저 할래?\'라며 작은 선택권을 제공합니다. \'네가 선택한 거니까 네 방식으로 해봐\'라며 자율성을 존중합니다. 주 1회 \'이번 주 네가 선택하며 잘 해냈네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_31_수업부담_자율성'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_32_성장마인드셋_점검능력'}) SET n += {lpa_class: '냉소적 무기력형', x: '성장마인드셋', z: '점검능력', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '\'노력하면 발전한다\'는 신념이 있고, 스스로 학습을 점검하는 능력까지 더해지면 점검 결과를 \'다음엔 이렇게\'라는 개선으로 연결하며 학업성취가 증가합니다. 냉소적 무기력형은 신념은 있으나 점검 없이는 개선 방향을 모르는 상태이므로, 점검 도구 제공이 필수입니다.', strategy: '\'계획-실행-점검 3단계 노트\'를 제공합니다. 매일 \'오늘 계획 1개, 실행 여부, 점검(잘된 점/아쉬운 점)\'을 기록하게 하고, 금요일에 \'이번 주 월요일보다 수요일이 나아졌네. 이게 발전이야\'라며 성장을 가시화합니다. 점검 시 \'안 된 것도 괜찮아. \'이 방법은 안 되는구나\'를 알게 된 것도 성장이야\'라며 실패를 학습 기회로 재구성합니다. 주 1회 교사가 노트에 \'이번 주 점검 습관 좋아. 네가 발전하고 있어\'라는 코멘트를 남깁니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_32_성장마인드셋_점검능력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_33_의미감_조절능력'}) SET n += {lpa_class: '냉소적 무기력형', x: '의미감', z: '조절능력', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '의미감이 높을수록 조절능력도 함께 좋아지는 경향이 있습니다. “왜 해야 하는지”가 분명하면 감정이 흔들려도 다시 붙는 힘이 생기기 쉽습니다. 다만 냉소적 무기력형은 의미가 ‘머리로만’ 남고 행동으로 안 옮겨지는 경우가 많아서, 의미를 바로 ‘작은 행동’으로 번역해줘야 조절이 살아납니다.', strategy: '“의미 → 5분 행동” 연결을 고정합니다. “그게 중요하다면 오늘 5분만 뭘 할래?”로 시작을 만들고, 막힐 때 쓸 조절 루틴(3-3-3: 3초 멈춤-3번 호흡-3초 후 재시작)을 함께 줍니다. 교사는 “감정은 정보, 결정은 행동”이라고 반복하고, 5분을 해낸 즉시 “의미를 행동으로 옮긴 게 진짜 조절이야”라고 강화합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_33_의미감_조절능력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_34_자기정서조절_친구 공부비교'}) SET n += {lpa_class: '냉소적 무기력형', x: '자기정서조절', z: '친구 공부비교', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '감정을 잘 조절하는 능력이 있어도 친구와 공부를 비교하는 상황에서는, 비교 스트레스가 정서조절 능력을 소진시켜 학업성취가 감소합니다. 냉소적 무기력형은 정서조절은 양호하나 비교 스트레스가 높은 상태이므로, 비교 차단 + 자기준거 강화가 필요합니다. 중등 시기 또래 비교 민감도가 최고조이므로, 내적 기준 전환이 핵심입니다.', strategy: '\'비교 차단 + 자기준거\' 전략을 도입합니다. \'친구 점수 말고, 네가 어제보다 오늘 뭘 더 했는지만 봐. 그게 네 성장이야\'라며 자기준거 평가를 강조합니다. \'나의 성장 그래프\'(이번 주 vs 지난주 비교)를 노트에 기록하게 하고, \'친구 아니라 네 과거와 비교해\'라며 내적 기준을 명시합니다. 시험 후 \'친구 점수 묻지 말고, 네가 틀린 부분만 확인해\'라며 비교 차단 행동을 안내합니다. 주 1회 \'이번 주 네 기준으로 잘 성장했네\'라며 피드백합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_냉소적 무기력형_34_자기정서조절_친구 공부비교'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_35_무능감_친구 정서지지'}) SET n += {lpa_class: '냉소적 무기력형', x: '무능감', z: '친구 정서지지', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '\'나는 못 해\'라는 무능감이 있는 학생이 친구의 정서적 지지를 받으면, 지지가 오히려 시도 회피를 정당화(\'친구가 위로해주니 안 해도 괜찮아\')하여 학업성취가 감소합니다. 냉소적 무기력형은 무능감이 높고 친구 지지에 의존하므로, 지지를 \'함께 시도\'로 전환하고 작은 성공으로 효능감을 회복해야 합니다. 중등 시기 또래 영향력이 강하므로, 친구 지지를 학습 동기로 연결하는 것이 핵심입니다.', strategy: '\'함께 시도 + 성공 경험\' 전략을 도입합니다. \'친구가 \'괜찮아\'라고 하는 건 \'같이 해보자\'는 뜻이야. 함께 1분만 시도해보자\'라며 지지를 협력으로 재구성합니다. \'1분 안에 풀 수 있는 쉬운 문제\'를 친구와 함께 풀게 하고, 성공 후 \'해냈네! 친구와 함께 하니까 할 수 있잖아\'라며 협력-성공 연결을 명시합니다. \'나는 할 수 있다\' 노트(친구와 함께 성공한 것 기록)를 작성하게 하고, 주 1회 \'이번 주 친구와 함께 시도했네. 대단해\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_35_무능감_친구 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_36_수업태도_타인공감능력'}) SET n += {lpa_class: '냉소적 무기력형', x: '수업태도', z: '타인공감능력', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '수업에 참여하는 태도가 좋고, 친구나 교사의 감정을 잘 읽는 능력까지 더해지면 수업 분위기를 학습 자원으로 활용하며 학업성취가 증가합니다. 냉소적 무기력형은 참여 동력이 부족하나, 공감 능력으로 \'선생님이 기대하고 있구나\'를 감지하면 참여가 강화됩니다.', strategy: '\'기대 신호 보내기\'를 전략적으로 활용합니다. 수업 시작 시 \'오늘 ○○의 의견이 궁금해\'라며 기대를 명시적으로 표현합니다. 학생이 참여할 때 \'그렇지! 네가 잘 이해했네\'라며 즉각 긍정 피드백을 제공합니다. 수업 후 \'오늘 네가 ○○ 설명할 때, 친구들이 고개 끄덕였어. 눈치챘어?\'라며 타인의 반응을 가시화합니다. 월 1회 \'수업 기여 카드\'(친구에게: \'네 설명이 도움 됐어\' 메시지 쓰기)로 공감-참여의 선순환을 만듭니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_36_수업태도_타인공감능력'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_37_교사 수업부담_타인정서인식'}) SET n += {lpa_class: '냉소적 무기력형', x: '교사 수업부담', z: '타인정서인식', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '교사가 수업 부담을 크게 주는 상황에서 타인의 정서를 잘 읽는 학생은, 교사의 부담 신호를 포착하여 더 위축되고 학업성취가 감소합니다. 냉소적 무기력형은 타인정서인식은 양호하나 수업 부담이 높은 상태이므로, 부담 경감 + 긍정 신호 제공이 필요합니다.', strategy: '\'긍정 신호 + 부담 경감\' 전략을 도입합니다. 수업 시작 시 \'오늘은 편하게 해도 돼\'라며 안전한 분위기를 조성합니다. 학생이 시도할 때 미소, 고개 끄덕임 같은 긍정 신호를 보내고, 수업 후 \'아까 선생님이 웃었을 때 봤어? 네가 잘하고 있었거든\'이라며 신호를 명시적으로 해석합니다. 수업 부담을 \'오늘은 2문제만\'으로 줄이고, 주 1회 \'이번 주 편하게 참여했네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_37_교사 수업부담_타인정서인식'};
MERGE (n:ModerationPath {id: 'MOD_냉소적 무기력형_38_유능성_활기'}) SET n += {lpa_class: '냉소적 무기력형', x: '유능성', z: '활기', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '\'나는 할 수 있다\'는 믿음이 있고, 에너지와 활력까지 더해지면 자신감을 행동으로 전환하며 학업성취가 증가합니다. 냉소적 무기력형은 유능감과 활기 모두 부족하므로, 작은 성공으로 유능감을 회복하고 활기를 유도해야 합니다.', strategy: '\'성공 → 에너지 활성화\' 전략을 도입합니다. \'1분 안에 풀 수 있는 쉬운 문제 1개\'로 즉각 성공 경험을 제공하고, 성공 후 \'해냈네! 기분 어때? 뿌듯하지?\'라며 정서를 활성화합니다. \'이 에너지로 다음 문제도 해보자\'라며 유능감을 활기로 전환합니다. 수업 중 \'성공 파이팅 구호\'(문제 풀면 \'예스!\' 외치기)로 에너지를 강화하고, 주 1회 \'이번 주 네가 자신감 있게 참여했네\'라며 피드백합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_냉소적 무기력형_38_유능성_활기'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_1_관계성_게임 과몰입'}) SET n += {lpa_class: '정서조절 취약형', x: '관계성', z: '게임 과몰입', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '관계성이 높은 학생이 게임 과몰입을 보일 때, 관계가 게임 유지에 기여할 수도 있고 학습 전환의 동력이 될 수도 있습니다. 중학생은 또래 영향력이 크기 때문에, 관계를 어떻게 구조화하느냐에 따라 성취 변화가 크게 달라질 수 있습니다. 따라서 이 조합에서는 관계를 학습 공동체로 재배치해 게임 시간을 ‘줄이는 방향’으로 쓰는 것이 필요합니다.', strategy: '‘게임 이야기 금지’처럼 통제하기보다 관계를 학습으로 옮기는 규칙을 만들어 주는 것이 좋습니다. “먼저 학습 한 문장부터 말하고, 그 다음 자유 대화하자”처럼 순서를 정해 관계의 방향을 바꾸는 방식이 효과적입니다. 게임 시간 줄이기는 개인 목표보다 ‘팀 목표(주당 -30분)’로 설정하고, 성공하면 교사가 과정 칭찬으로 강화하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_1_관계성_게임 과몰입'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_2_점검능력_계획능력'}) SET n += {lpa_class: '정서조절 취약형', x: '점검능력', z: '계획능력', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '점검능력과 계획능력이 함께 높으면, 정서가 흔들려도 ‘다음 행동’을 복구할 가능성이 커져 성취가 올라갈 수 있습니다. 정서조절 취약형은 감정이 올라오면 실행이 끊기기 쉬운데, 계획은 방향을 잡아주고 점검은 수정점을 제공해 재시작을 돕습니다. 따라서 계획-점검을 작게 매일 돌리게 만드는 것이 필요합니다.', strategy: '“오늘은 10분짜리 목표 하나만 정하고, 끝날 때 1분만 점검하자”처럼 단위를 작게 고정하는 것이 좋습니다. 점검은 “잘된 1, 막힌 1, 내일 바꿀 1”로 틀을 고정하고, ‘바꿀 1’은 5분 과제로 즉시 연결해 실행까지 이어지게 합니다. 감정이 올라오면 계획을 수정하지 말고 단위만 줄이는 규칙(10분→5분)을 적용하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_2_점검능력_계획능력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_3_무능감_고갈'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '고갈', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '무능감과 고갈이 함께 크면 ‘해도 안 된다’와 ‘할 힘이 없다’가 겹치며 학습이 멈추는 상태입니다. 정서조절 취약형에서는 이 조합이 불안과 짜증을 빠르게 키워 회피로 굳어지기 쉽습니다. 따라서 기술 훈련보다 회복과 초미세 성공을 먼저 설계하는 것이 필요합니다.', strategy: '이번 주 목표를 ‘회복’으로 선언하고 수업 목표를 ‘최소 참여’로 낮추는 것이 좋습니다. “오늘은 밑줄 3개만 하고 끝내자”처럼 성공 기준을 작게 잡고, 성공하면 바로 종료해 부담을 남기지 않는 방식이 효과적입니다. 피드백은 “네가 끝까지 한 행동이 실력이다”처럼 행동-근거 중심으로 주고, 공개 비교나 설교는 무능감을 키우므로 피하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_3_무능감_고갈'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_4_성적부담_공부부담'}) SET n += {lpa_class: '정서조절 취약형', x: '성적부담', z: '공부부담', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '성적부담과 공부부담이 함께 높아지면, 학교에서도 집에서도 ‘계속 평가받는 느낌’이 커져 불안이 유지되고 성취가 떨어지기 쉽습니다. 정서조절 취약형은 부담이 누적될수록 감정 고조가 길게 이어지므로, 부담을 줄이면서도 학습을 완전히 끊지 않도록 ‘최소 재진입 루틴’을 만들어주는 게 핵심입니다.', strategy: '부담을 “핵심 1유형 + 최소 목표”로 축소합니다. “오늘은 2문제만 풀면 충분합니다(연습)”를 먼저 선언하고, 마무리는 오답 1개만 잡고 종료합니다. 교사는 “지금은 양이 아니라 재진입이 목표”라고 말해주고, 다음 날 같은 시간에 10분(혹은 5분)만 반복하는 리듬을 만듭니다. 부담이 큰 주에는 과제량을 더 줄여도 ‘마무리(오답표시/다음1개)’만은 남기게 합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_4_성적부담_공부부담'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_5_고갈_공부환경'}) SET n += {lpa_class: '정서조절 취약형', x: '고갈', z: '공부환경', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '고갈이 큰 학생에게 공부환경이 갖춰져 있어도, 에너지 자체가 부족하면 실행이 붙지 않아 성취가 떨어질 수 있습니다. 정서조절 취약형은 피로가 누적되면 감정이 예민해지고 회피가 늘어나므로, 환경만 좋아져도 자동으로 공부가 되지는 않습니다. 따라서 이 조합에서는 환경을 ‘동기’가 아니라 ‘시작 장벽을 낮추는 장치’로만 쓰는 관점이 필요합니다.', strategy: '환경을 한 번에 바꾸기보다 ‘한 가지’만 고정해 시작 부담을 낮추는 것이 좋습니다. “자리에 앉으면 타이머 5분을 켠다”는 규칙 하나만 정하고, 필기구와 자료를 한 세트로 고정해 ‘찾는 시간’을 없애는 방식이 효과적입니다. 고갈이 큰 날은 환경 정비와 5분 시작만 성공하면 바로 종료해 ‘할 수 있다’ 경험을 남기는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_5_고갈_공부환경'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_6_무능감_관계성'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '관계성', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '무능감이 큰 상태에서 관계성이 있어도, 관계가 ‘비교/평가’로 느껴지면 오히려 압력이 되어 성취가 떨어질 수 있습니다. 중학생은 체면이 중요한 만큼, ‘친구들 앞에서 못하면 창피’가 회피로 이어지기 쉽습니다. 따라서 관계를 공개 평가가 아니라 비공개 협력으로 설계하는 것이 필요합니다.', strategy: '관계를 ‘조용한 협력’으로 운영하는 것이 좋습니다. 발표를 강요하기보다 기록·정리 같은 보조 역할로 참여를 유지시키고, 버디 활동도 수업 후 3분만 조용히 진행하면 노출 부담이 줄어듭니다. 칭찬은 공개보다 개인 메시지로 전달해 체면 부담을 낮추는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_6_무능감_관계성'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_7_성적부담_교사 성적압력'}) SET n += {lpa_class: '정서조절 취약형', x: '성적부담', z: '교사 성적압력', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '성적부담이 큰 상태에서 교사의 성적 압력이 더해지면, 정서조절 취약형은 ‘지금 여기서 틀리면 끝’처럼 위협으로 느끼며 불안이 과열되기 쉽습니다. 불안이 올라가면 실행이 끊기고, 결국 성취가 떨어지는 패턴이 생길 수 있습니다. 따라서 교실은 압박을 올리는 공간이 아니라 ‘안전한 연습 공간’으로 재설계되어야 합니다.', strategy: '“연습 선언 + 목표 축소 + 부분 성공 인정”을 세트로 운영합니다. 수업 시작에 “오늘은 틀려도 되는 연습”을 선언하고, 목표를 핵심 1유형(또는 2문제)로 줄입니다. 학생이 막히면 “여기까지는 맞아, 다음 한 단계만”으로 부분 성공을 즉시 인정해 불안을 낮춥니다. 성적 목표는 ‘오답 1개 줄이기/풀이 1문장 설명’처럼 과정 목표로 바꾸고, 평가 언어(점수/등수)는 최소화합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_7_성적부담_교사 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_8_부모 성적압력_교사 수업부담'}) SET n += {lpa_class: '정서조절 취약형', x: '부모 성적압력', z: '교사 수업부담', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '가정의 성적압력과 교실의 수업부담이 함께 크면, 정서조절 취약형은 ‘항상 평가받는다’는 느낌으로 불안이 누적되어 성취가 떨어질 수 있습니다. 중학생은 또래 비교가 있는 환경에서 수치심이 쉽게 올라오므로, 이 조합은 회피나 폭발로 이어질 위험이 커집니다. 따라서 학교에서는 압력을 완충하고, 안전한 연습과 최소 목표로 재진입을 만드는 것이 필요합니다.', strategy: '“오늘은 평가가 아니라 연습입니다, 틀려도 된다”를 먼저 선언하고 과제량을 핵심 1유형 수준으로 줄이는 것이 좋습니다. “지금은 점수를 올리기보다, 오답 2개만 잡고 끝내자”처럼 목표를 좁히면 불안이 내려갑니다. 가정에는 성적 대화를 ‘오답 2개+다음 행동 1개’로 제한하도록 안내해 압력을 낮추는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_8_부모 성적압력_교사 수업부담'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_9_부모 공부부담_교사 정서지지'}) SET n += {lpa_class: '정서조절 취약형', x: '부모 공부부담', z: '교사 정서지지', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '부모 공부부담이 큰 상황에서는 정서지지가 있어도 집에서 압박을 다시 경험하며 효과가 제한될 수 있습니다. 정서조절 취약형은 지속 압박이 감정 고조를 유지시키기 때문에, 교실에서만큼은 회복 경험을 확실히 만들어 두는 것이 중요합니다. 따라서 교실에서 성취를 잠그고, 집에서 버틸 최소 규칙을 함께 만드는 것이 필요합니다.', strategy: '수업에서 ‘안전한 실패 존’을 운영하며 부분 성공을 즉시 인정하는 것이 좋습니다. 학생과 함께 “집에서는 10분만 하고 종료” 같은 규칙을 정해 압박을 관리하도록 돕고, 필요하면 보호자에게 결과 질문을 줄이는 대화 규칙을 안내하는 것이 바람직합니다. 압박이 강한 주에는 목표를 즉시 낮추어 10분을 5분으로 조정하는 것이 효과적입니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_9_부모 공부부담_교사 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_10_자기효능감_노트하기'}) SET n += {lpa_class: '정서조절 취약형', x: '자기효능감', z: '노트하기', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '자기효능감이 높고 노트하기가 많아도, 정서조절 취약형에서는 노트가 완벽주의로 변하면 과부하가 생겨 성취가 떨어질 수 있습니다. 중학생은 ‘잘하고 싶다’가 강할수록 정리 행동이 늘어나고, 그만큼 실행이 느려질 수 있습니다. 따라서 노트를 학습 증거로 재정의하고, 최소 규칙으로 제한하는 것이 필요합니다.', strategy: '노트 목표를 ‘핵심 3줄+예시 1개’로 고정하고 7분 타이머로 끝내는 것이 좋습니다. “너는 해낼 수 있으니까 더 잘하려고 합니다, 그런데 오늘은 3줄이면 충분하다”라고 말해 기준을 낮추면 과부하가 줄어듭니다. 노트 후 바로 문제 1개 적용으로 연결해 정리→적용 흐름을 만들면 성취로 이어지기 쉽습니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_10_자기효능감_노트하기'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_11_시험준비_몰두'}) SET n += {lpa_class: '정서조절 취약형', x: '시험준비', z: '몰두', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '시험준비와 몰두가 함께 높으면 단기간 성취가 좋아 보일 수 있지만, 정서조절 취약형에서는 과몰입이 긴장과 피로를 키워 성취가 떨어질 수 있습니다. 중학생은 시험 기간에 수면/리듬이 흔들리기 쉬워, 몰두가 ‘버티기’로 바뀌면 다음 날 회복이 어려워집니다. 따라서 몰두는 짧게, 준비는 규칙적으로 설계해 컨디션을 지키는 것이 필요합니다.', strategy: '몰두 시간은 10분 단위로 자르고 “10분 준비 후 2분 쉬기”를 두 번까지만 하도록 제한하는 것이 좋습니다. 몰두가 길어지려 하면 “지금 멈추는 것도 전략이다”라고 말해 휴식 기준을 허용하면 과부하를 줄일 수 있습니다. 마무리는 ‘오답 1개 규칙’으로 끝내고, 다음 날 같은 시간에 반복하도록 리듬을 만드는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_11_시험준비_몰두'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_12_관계성_무능감'}) SET n += {lpa_class: '정서조절 취약형', x: '관계성', z: '무능감', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '관계성이 있어도 무능감이 크면, 관계가 위로만 남고 시도는 붙지 않아 성취가 떨어질 수 있습니다. 정서조절 취약형은 실패 감정이 커질 때 관계 속에서도 ‘못하면 창피’가 되어 더 위축되기 쉽습니다. 따라서 이 조합에서는 관계를 정서 지지로만 쓰지 말고 ‘함께 성공’으로 전환하는 것이 필요합니다.', strategy: '버디 활동을 ‘함께 공부하기’가 아니라 ‘함께 성공하기’로 설계하는 것이 좋습니다. “오늘은 너희 둘이 가장 쉬운 1문제만 같이 풀고 끝내자”처럼 성공률이 높은 과제를 짧게 제시하면 무능감이 덜 자극됩니다. 성공 후에는 “친구 덕분”만 남기지 말고 “네가 끝까지 해서 해냈다”로 개인 효능감을 연결해 주는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_12_관계성_무능감'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_13_성장마인드셋_반감-냉소'}) SET n += {lpa_class: '정서조절 취약형', x: '성장마인드셋', z: '반감-냉소', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '성장마인드셋이 높고 냉소가 함께 존재하면, ‘싫어도 방법을 바꾸면 된다’는 믿음이 행동 전환을 촉진해 성취가 올라갈 수 있습니다. 정서조절 취약형은 감정이 올라오면 멈추기 쉬운데, 성장 신념이 ‘다음 시도’로 연결될 때 회복 속도가 빨라집니다. 따라서 냉소를 없애려 하기보다 ‘방법 바꾸기’로 전환시키는 것이 필요합니다.', strategy: '“어차피”가 나오면 “그럼 이번엔 방법을 바꿔볼까?”로 즉시 전환하는 한 문장을 고정하는 것이 좋습니다. 바꿀 방법을 2가지 선택지로 제시하고(예: 예시 먼저/문제 먼저), 5분만 실험한 뒤 “방식을 바꿔서 풀렸다=성장이다”를 근거로 확인해 주면 행동이 붙습니다. 냉소는 인정하되, 행동은 ‘짧게’로 고정해 실험이 반복되게 만드는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_13_성장마인드셋_반감-냉소'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_14_의미감_부모 공부부담'}) SET n += {lpa_class: '정서조절 취약형', x: '의미감', z: '부모 공부부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '의미감이 있어도 부모 공부부담이 크면 의미가 ‘압박의 근거’가 되어 성취가 떨어질 수 있습니다. 정서조절 취약형은 압박이 지속되면 감정 고조가 유지되어, 내적 동기가 외적 통제로 바뀌기 쉽습니다. 따라서 의미를 부모 기대에서 분리하고, 가정 대화 규칙을 조정해 부담을 낮추는 것이 필요합니다.', strategy: '“이건 부모님 기대가 아니라 네 목표다”라고 분리해주고, ‘내 이유 카드’는 학생만 갖고 있게 하는 것이 좋습니다. 가정에는 “조언 금지, 질문만”과 “오늘 한 것 한 줄만 듣기” 규칙을 안내해 압박을 줄이는 것이 효과적입니다. 학교에서는 5분 행동으로 의미를 ‘실행’으로만 연결하고, 추가 요구는 줄이는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_14_의미감_부모 공부부담'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_15_교사 수업부담_부모 성적압력'}) SET n += {lpa_class: '정서조절 취약형', x: '교사 수업부담', z: '부모 성적압력', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '교사가 수업부담을 크게 주고 가정에서 성적압력이 높으면, 정서조절 취약형은 ‘도망칠 곳이 없다’는 압박을 느끼기 쉽습니다. 중학생은 평가에 민감하므로 불안이 높아지면 회피나 폭발로 전환될 위험이 커지고 성취가 떨어질 수 있습니다. 따라서 이 조합에서는 교사가 학교를 ‘안전한 연습 공간’으로 만들어 압력을 완충하는 것이 필요합니다.', strategy: '평가·속도·과제량을 즉시 낮추고 “오늘은 연습입니다, 틀려도 된다”를 선언하는 것이 좋습니다. “오늘은 2문제만 풀면 충분합니다, 과정 보고 연습하자”라고 말하며 목표를 축소하면 불안을 낮출 수 있습니다. 가능하다면 가정에는 점수 질문을 줄이고 과정 질문 3개로 바꾸도록 구체적으로 안내해 압력원을 줄이는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_15_교사 수업부담_부모 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_16_점검능력_부모 의사소통'}) SET n += {lpa_class: '정서조절 취약형', x: '점검능력', z: '부모 의사소통', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '점검능력과 부모 의사소통이 함께 높으면, 감정이 흔들려도 점검이 실행으로 바뀌며 성취가 올라갈 수 있습니다. 정서조절 취약형은 혼자 점검할 때 자책으로 흐르기 쉬운데, 대화가 인정→질문→선택으로 운영되면 점검이 행동으로 전환됩니다. 따라서 주기와 틀을 고정해 점검 대화가 부담이 되지 않게 하는 것이 필요합니다.', strategy: '일주일에 2–3번만 점검하고 “대체로 잘 되고 있나?” 정도로 시작해 부담을 낮추는 것이 좋습니다. 금요일 5분만 “잘된 것 1개, 막힌 것 1개, 다음에 바꿀 것 1개”를 정하고, ‘바꿀 것 1개’는 5분 과제로 즉시 연결하면 실행이 붙습니다. 대화는 조언이 아니라 선택으로 끝내 “그럼 A/B 중 뭐가 더 현실적이냐”로 마무리하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_16_점검능력_부모 의사소통'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_17_부모 공부부담_부모 학업지지'}) SET n += {lpa_class: '정서조절 취약형', x: '부모 공부부담', z: '부모 학업지지', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '부모 공부부담이 큰 상황에서는 부모의 학업지지가 있어도 학생이 지지를 ‘조건부(잘해야 인정)’로 해석하면 성취가 떨어질 수 있습니다. 중학생은 자율성 욕구가 커서, 지지가 통제로 느껴지면 반감이 커질 수 있습니다. 따라서 지지를 ‘과정 지지’로 순수화하고 역할을 제한하는 것이 필요합니다.', strategy: '부모 지지를 과정 중심으로 고정하는 것이 좋습니다. “결과는 묻지 말고 오늘 한 노력 1개만 들어달라”는 대화 규칙을 안내하고, 학생이 부모에게 보여줄 ‘작은 성취 1줄(10분/오답 1개)’을 미리 준비하게 하면 갈등이 줄어듭니다. 압박이 큰 주에는 가정 목표를 환경 정리로만 제한하고, 학습 목표는 교실에서 최소화하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_17_부모 공부부담_부모 학업지지'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_18_반감-냉소_성장마인드셋'}) SET n += {lpa_class: '정서조절 취약형', x: '반감-냉소', z: '성장마인드셋', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '반감·냉소가 있어도 성장마인드셋이 높으면 ‘지금은 싫지만 바뀔 수 있다’는 믿음이 행동 전환을 촉진할 수 있습니다. 정서조절 취약형은 감정이 올라오면 멈추기 쉬운데, 성장 신념이 ‘방법 바꾸기’로 연결될 때 회복 속도가 빨라집니다. 따라서 냉소를 없애기보다 성장 신념을 다음 시도로 연결하는 것이 필요합니다.', strategy: '냉소를 ‘성장 언어’로 바꾸는 한 문장을 고정하는 것이 좋습니다. “어차피”가 나오면 “그럼 이번엔 방법을 바꿔볼까?”로 즉시 전환하고, 바꿀 방법 2가지를 선택지로 제시하면 행동이 붙습니다. 5분 실험 뒤 1분 점검으로 “방식을 바꿔서 풀렸네=성장이다”를 근거로 확인해 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_18_반감-냉소_성장마인드셋'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_19_무능감_성적부담'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '성적부담', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '무능감과 성적부담이 함께 커질수록 “못할 것 같은데 점수는 나와야 한다”는 이중 압박이 생기고, 불안·짜증이 빠르게 올라가면서 회피로 굳어지기 쉽습니다. 정서조절 취약형은 감정이 올라오면 실행이 끊기기 쉬워, 이 구간에서는 기술 훈련보다 ‘압박을 내려놓고 바로 성공하는 경험’을 먼저 만들어야 합니다.', strategy: '레드 플래그로 즉시 개입합니다. “오늘은 점수 얘기 안 함. 목표는 성공 1개”를 선언하고 1분 안에 풀 수 있는 쉬운 문제 1개로 시작합니다. 성공 직후 “지금 ‘못한다’는 생각과 달리 해낸 증거가 생겼다”를 말로 붙입니다. 성적부담은 “어제의 나보다 1개 더 이해하면 성공” 같은 자기준거 기준으로 바꾸고, 공개 비교/훈계는 피합니다. 가능하면 가정에도 결과 질문을 줄이고 과정 질문 1~2개만 하도록 안내합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_19_무능감_성적부담'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_20_시험준비_수업부담'}) SET n += {lpa_class: '정서조절 취약형', x: '시험준비', z: '수업부담', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '시험준비가 있고 수업부담이 클 때, 준비가 막막함을 줄여 성취를 촉진할 수도 있지만, 동시에 부담이 커지면 역효과가 날 수 있습니다. 정서조절 취약형은 막막함이 감정 고조를 키우므로, 시험준비의 구조가 ‘다음 한 걸음’을 정해주면 회복이 빨라집니다. 따라서 부담을 줄인 준비 틀을 제공하고, ‘1유형만’으로 성공을 고정하는 것이 필요합니다.', strategy: '“오늘은 범위를 줄여서 1유형만 준비하자”로 폭을 좁히고, 오답은 2개만 골라 ‘다음 규칙 1개’로 끝내는 것이 좋습니다. 수업부담이 큰 주에는 준비 시간을 10분으로 제한하고 반드시 종료해 과부하를 막는 것이 효과적입니다. 끝나면 “여기까지면 충분하다”로 마무리해 다음 날 재진입 여지를 남기는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_20_시험준비_수업부담'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_21_유능성_수업태도'}) SET n += {lpa_class: '정서조절 취약형', x: '유능성', z: '수업태도', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '유능성과 수업태도가 좋아도, 정서조절 취약형에서는 ‘잘해야 한다’가 압박으로 변하면 성취가 떨어질 수 있습니다. 기본 역량이 있는 학생일수록 기대가 커지고, 기대가 높을수록 실패 두려움이 커지기 쉽습니다. 따라서 유능함을 도전 과제로 몰기보다 안정된 기본기 성공으로 고정하는 것이 필요합니다.', strategy: '“너는 기본기가 있으니 오늘은 기본 유형을 빠르게 성공시키고 끝내자”처럼 쉬운 성공을 먼저 고정하는 것이 좋습니다. 도전 과제는 선택으로 두고, 기본 성공이 쌓인 뒤에만 확장하면 실패 두려움이 줄어듭니다. 유능함은 또래 비교로 강조하지 말고 “네 방식이 통한다”처럼 자기준거로 인정하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_21_유능성_수업태도'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_22_노트하기_스마트폰 의존'}) SET n += {lpa_class: '정서조절 취약형', x: '노트하기', z: '스마트폰 의존', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '노트하기가 많아도 스마트폰 의존이 높으면 노트 시간이 자주 끊기고 ‘정리→적용’이 이어지지 않아 성취가 떨어질 수 있습니다. 중학생은 즉각보상 경쟁이 커서 환경 통제가 없으면 집중이 쉽게 무너집니다. 따라서 이 조합에서는 노트 성공 조건을 폰 통제와 묶고, 짧게 성공시키는 구조가 필요합니다.', strategy: '노트 시간(예: 7분) 동안 폰을 물리적으로 보관하고, 끝나면 2분 허용처럼 예측 가능한 규칙을 만드는 것이 좋습니다. “7분만 쓰고 끝내자, 그 다음은 네가 선택해”라고 말하면 통제감과 지속이 함께 올라갑니다. 노트는 핵심 3줄로 끝내고 바로 문제 1개를 풀게 하여 성취감을 만들면 회피가 줄어듭니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_22_노트하기_스마트폰 의존'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_23_부모 의사소통_시간관리'}) SET n += {lpa_class: '정서조절 취약형', x: '부모 의사소통', z: '시간관리', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '부모 의사소통이 원활하고 시간관리 능력이 있으면, 감정이 흔들려도 생활 리듬을 회복하며 성취가 올라갈 수 있습니다. 정서조절 취약형은 ‘시작’이 어려운 날이 많기 때문에, 부모와의 대화가 시간 리듬을 확인해 주면 재진입이 쉬워집니다. 따라서 이 조합에서는 시간을 ‘계획표’가 아니라 ‘타이머 루틴’으로 고정하는 것이 필요합니다.', strategy: '하루에 “10분-2분” 타이머 루틴을 1~2세트만 하고, 끝나면 반드시 종료하는 규칙을 만드는 것이 좋습니다. 대화는 “몇 시간 했어?”가 아니라 “오늘 타이머 한 번 돌렸어?”로 바꾸면 압박이 줄어듭니다. 학생이 직접 “오늘은 10분 1세트 했어요”라고 보고하도록 하고, “좋습니다, 그걸로 충분하다”로 인정해 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_23_부모 의사소통_시간관리'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_24_무능감_시험준비'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '시험준비', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '무능감이 큰 학생에게 시험준비가 붙으면, 불안을 ‘구조’로 바꿔 통제감을 주면서 성취가 빠르게 회복될 수 있습니다. 정서조절 취약형은 감정이 올라오면 산만해지는데, 시험준비의 체크 구조가 ‘다음 한 걸음’을 정해주면 재진입이 쉬워집니다. 따라서 이 조합에서는 시험준비를 ‘완벽 준비’가 아니라 ‘통제감 도구’로 쓰게 하는 것이 필요합니다.', strategy: '시험준비를 ‘오늘 할 것 1개’만 정하는 카드로 단순화하는 것이 좋습니다. “맞습니다, 지금은 자신감이 떨어집니다. 그래서 오늘은 1유형만 하자”라고 말하며 단위를 줄여 주면 무능감이 덜 자극됩니다. 준비는 문제 수가 아니라 ‘오답 규칙 1개’로 끝내게 하고, 수업 후 3분 동안 “내일 5분 무엇을 할지”를 함께 확정해 재시작을 보장하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_24_무능감_시험준비'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_25_수업태도_유능성'}) SET n += {lpa_class: '정서조절 취약형', x: '수업태도', z: '유능성', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '수업태도와 유능성이 높아도, 정서조절 취약형에서는 감정이 흔들릴 때 ‘잘해야 한다’가 압박으로 변해 성취가 떨어질 수 있습니다. 기본 역량이 있는 학생일수록 기대가 커지고, 기대가 높을수록 실패 두려움이 커질 수 있습니다. 따라서 유능성을 ‘도전’이 아니라 ‘안정된 기본기’로 활용해 성공 경험을 고정하는 것이 필요합니다.', strategy: '“너는 기본기가 있으니 오늘은 기본 유형을 빠르게 성공시키고 끝내자”처럼 쉬운 성공을 먼저 고정하는 것이 좋습니다. 도전 과제는 ‘선택’으로 두고, 기본 성공이 쌓인 뒤에만 확장하면 실패 두려움이 줄어듭니다. 유능함을 또래 비교로 강조하지 말고, “네 방식이 통한다”처럼 자기준거로 인정해 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_25_수업태도_유능성'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_26_자기효능감_의미감'}) SET n += {lpa_class: '정서조절 취약형', x: '자기효능감', z: '의미감', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '자기효능감과 의미감이 높아도, 정서조절 취약형에서는 ‘내 꿈을 위해 더 해야 한다’가 압박으로 커지면 성취가 떨어질 수 있습니다. 중학생은 진로 연결이 동기가 되지만, 목표가 커질수록 실패 두려움도 함께 커질 수 있습니다. 따라서 의미는 짧게, 효능감은 ‘작게 성공하기’로 묶어 과부하를 막는 것이 필요합니다.', strategy: '“네 목표에 도움이 됩니다, 그래서 오늘은 10분만 하고 끝내자”처럼 의미와 행동 단위를 함께 제시하는 것이 좋습니다. 효능감은 결과가 아니라 규칙 준수(10분 후 종료, 오답 1개)를 칭찬해 과부하를 줄입니다. 진로 연결 문장은 주 2–3번만 쓰고, 나머지는 루틴으로 유지하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_26_자기효능감_의미감'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_27_무능감_자기정서인식'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '자기정서인식', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '무능감이 크고 자기정서인식이 높으면 불안·수치심을 더 또렷하게 느끼며 회피가 강화되어 성취가 떨어질 수 있습니다. 중학생은 감정이 공개될까 두려워하므로, 감정 인식을 길게 다루면 오히려 멈춤이 커질 수 있습니다. 따라서 감정은 짧게 인정하고 곧바로 최소 행동으로 전환시키는 것이 필요합니다.', strategy: '감정 인식을 ‘10초-행동 1개’로 고정하는 것이 좋습니다. “지금 감정 한 단어만 말하고, 오늘은 밑줄 3개만 하자”처럼 선택지를 좁혀 주면 체면을 지키면서도 참여가 붙습니다. 수업 후에는 감정 1개와 행동 1개만 기록하게 하고, 행동을 구체적으로 인정해 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_27_무능감_자기정서인식'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_28_반감-냉소_자기정서조절'}) SET n += {lpa_class: '정서조절 취약형', x: '반감-냉소', z: '자기정서조절', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '냉소가 강한 상태에서는 자기정서조절 능력이 있어도, 냉소가 ‘조절할 이유’를 약화시켜 조절이 작동하지 않을 수 있습니다. 정서조절 취약형은 동기가 막히면 기술이 있어도 실행이 붙지 않습니다. 따라서 조절 기술을 곧바로 행동 전환과 연결해 ‘조절할 이유’를 확보하는 것이 필요합니다.', strategy: '조절 루틴을 한 번 실행한 뒤 바로 30초 행동으로 연결하는 것이 좋습니다. “숨 세 번 쉬고, 그 다음 밑줄 1개만 하자”처럼 조절→행동을 한 세트로 고정하면 기술이 성취로 이어지기 쉽습니다. 조절 성공을 “멈췄네, 그게 조절 실력이다”로 명명해 주고, 학생의 ‘내가 얻는 것’ 한 문장을 함께 만들어 이유를 붙이는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_28_반감-냉소_자기정서조절'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_29_의미감_자기효능감'}) SET n += {lpa_class: '정서조절 취약형', x: '의미감', z: '자기효능감', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '의미감과 자기효능감이 높아도, 정서조절 취약형에서는 ‘더 해야 한다’가 과부하로 바뀌면 성취가 떨어질 수 있습니다. 중학생은 진로/미래 연결이 동기가 되지만, 그 연결이 부담이 되면 회피로 전환될 위험이 있습니다. 따라서 의미는 짧게, 효능감은 ‘작게 성공하기’로 묶어 안정적으로 운영하는 것이 필요합니다.', strategy: '“네 목표에 도움이 됩니다, 그래서 오늘은 10분만 하고 끝내자”처럼 의미를 행동의 단위와 함께 제시하는 것이 좋습니다. 효능감은 ‘많이 하기’가 아니라 ‘규칙 준수(10분 후 종료, 오답 1개)’를 칭찬해 과부하를 막습니다. 일주일에 2–3번만 진로 연결 문장을 쓰고, 나머지는 루틴으로 유지하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_29_의미감_자기효능감'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_30_의미감_자아존중감'}) SET n += {lpa_class: '정서조절 취약형', x: '의미감', z: '자아존중감', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '의미감과 자아존중감이 높아도, 정서조절 취약형에서는 ‘내가 가치 있는 만큼 더 잘해야 한다’로 압박이 커지면 성취가 떨어질 수 있습니다. 중학생은 공개 평가에 민감해 작은 실수도 수치심으로 커질 수 있습니다. 따라서 존중 언어로 안전감을 주되, 기준은 작게 고정해 실행을 붙이는 것이 필요합니다.', strategy: '“점수와 상관없이 너는 소중합니다, 그래서 오늘은 핵심 1개만 정확히 잡자”처럼 존중과 기준을 동시에 주는 말이 좋습니다. 의미는 길게 말하지 않고 “너에게 이득 1개”만 확인한 뒤 5분 행동으로 바로 연결하면 압박이 줄어듭니다. 공개 비교를 피하고 개인 피드백으로 끝맺음을 보장하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_30_의미감_자아존중감'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_31_수업태도_자율성'}) SET n += {lpa_class: '정서조절 취약형', x: '수업태도', z: '자율성', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '수업태도와 자율성이 높아도, 정서조절 취약형에서는 자율성이 ‘내가 다 결정해야 한다’는 부담으로 변하면 성취가 떨어질 수 있습니다. 중학생은 자율성 욕구가 크지만 실행기능이 흔들릴 수 있어, 선택지가 많으면 오히려 멈출 수 있습니다. 따라서 자율성은 ‘작은 선택’으로 제한하고, 구조는 강하게 제공하는 것이 필요합니다.', strategy: '선택권은 크게 주기보다 “A/B 중 뭐 먼저 할래?”처럼 두 가지로 제한하는 것이 좋습니다. 선택 후에는 “네가 정한 것만 끝내면 된다”로 책임 범위를 줄여 부담을 낮춥니다. 자율성이 흔들리는 날은 선택을 줄이고 ‘5분만’으로 구조를 강화해 재진입을 돕는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_31_수업태도_자율성'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_32_무능감_점검능력'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '점검능력', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '무능감이 큰 학생에게 점검능력이 있어도, 점검이 ‘못한 증거’ 수집으로 흐르면 성취가 떨어질 수 있습니다. 정서조절 취약형은 점검 순간 감정이 올라오기 쉬워, 점검을 ‘평가’가 아니라 ‘조건 바꾸기’로 다루는 접근이 필요합니다. 따라서 이 조합에서는 점검을 짧게 하고 다음 행동으로 바로 연결하는 것이 필요합니다.', strategy: '점검을 ‘실험’으로 재정의하는 것이 좋습니다. “오늘은 왜 안 됐는지 말고, 어떤 조건이면 될지 하나만 바꿔보자”라고 말하며 점검 질문을 2개로 줄이면 자책을 막을 수 있습니다. 점검은 1분 안에 끝내고 곧바로 1분 성공 과제로 재진입시키는 흐름이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_32_무능감_점검능력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_33_부모 학업지지_조절능력'}) SET n += {lpa_class: '정서조절 취약형', x: '부모 학업지지', z: '조절능력', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '부모의 학업지지가 있고 조절능력이 있으면, 감정이 올라오는 순간에도 멈추고 다시 시작하는 힘이 커져 성취가 올라갈 수 있습니다. 정서조절 취약형은 조절 능력이 있어도 외부에서 인정과 지지가 없으면 지속이 약해지기 쉬운데, 과정 지지가 붙으면 조절이 행동으로 이어집니다. 따라서 이 조합에서는 조절을 ‘기술’이 아니라 ‘루틴’으로 굳히는 것이 필요합니다.', strategy: '“멈춤-호흡-재시작”을 한 세트로 정하고, 성공하면 “지금 조절했다, 그게 실력이다”로 즉시 인정해 주는 것이 좋습니다. 가정에서는 결과보다 “오늘 조절한 순간 1개가 뭐였냐”를 묻게 하면 조절 행동이 강화됩니다. 조절이 성공한 날은 5분 과제로 짧게 이어가고, 실패한 날은 단위를 더 줄여 ‘재시작’만 남기는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_33_부모 학업지지_조절능력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_34_교사 성적압력_친구 공부비교'}) SET n += {lpa_class: '정서조절 취약형', x: '교사 성적압력', z: '친구 공부비교', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '교사의 성적 압력과 친구 비교가 함께 걸리면, 정서조절 취약형은 ‘체면/수치심’이 빠르게 올라가서 회피나 폭발로 전환될 위험이 커집니다. 특히 중학생은 또래 시선이 행동을 좌우하는 시기라, 비교 자극이 들어오면 감정 조절이 무너지기 쉽습니다. 그래서 이 구간은 ‘압박을 낮추고 비교를 끊는 교실 규칙’이 먼저입니다.', strategy: '비교를 차단하고 과정 기준으로 바꿉니다. “오늘은 점수 비교 금지, 오답 2개만 잡으면 성공” 같은 규칙을 교실 공용어로 만듭니다. 교사는 성적 압력을 “기대+과정” 언어로 바꿔 “완벽이 아니라 꾸준함”을 강조합니다. 공개 질문/공개 채점은 최소화하고, 피드백은 개인 메시지로 전달해 체면 부담을 낮춥니다. 시험 후에도 “친구 점수 묻지 말고 내 오답만 보기”를 행동 규칙으로 안내합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_정서조절 취약형_34_교사 성적압력_친구 공부비교'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_35_무능감_친구 정서지지'}) SET n += {lpa_class: '정서조절 취약형', x: '무능감', z: '친구 정서지지', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '무능감이 큰 상태에서는 친구의 정서지지가 있어도, 지지가 ‘위로’로만 남으면 시도가 붙지 않아 성취가 떨어질 수 있습니다. 중학생은 또래 영향이 큰 만큼, 지지가 실행으로 이어지지 않으면 오히려 회피를 정당화할 위험도 있습니다. 따라서 이 조합에서는 또래 지지를 ‘함께 시도’로 구조화하는 것이 필요합니다.', strategy: '친구 지지를 ‘실행 지지’로 바꾸는 것이 좋습니다. “괜찮아” 대신 “같이 1문제만”이라는 문장을 버디 규칙으로 정하고, 5분 타이머로 짧게 운영하면 실천으로 이어지기 쉽습니다. 성공 후에는 “친구 덕분”에서 끝내지 말고 “네가 한 단계 해냈다”로 개인 효능감을 연결해 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_35_무능감_친구 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_36_자기정서조절_타인공감능력'}) SET n += {lpa_class: '정서조절 취약형', x: '자기정서조절', z: '타인공감능력', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '자기정서조절과 타인공감능력이 높아도, 정서조절 취약형에서는 타인의 감정에 과하게 반응하며 에너지가 소진되어 성취가 떨어질 수 있습니다. 중학생은 또래 관계가 중심이어서 공감이 강하면 관계에 쓰는 에너지가 커지고 학습이 밀릴 수 있습니다. 따라서 공감을 ‘돕기’에서 ‘학습 협력’으로 전환하고, 경계를 세우는 연습이 필요합니다.', strategy: '공감을 칭찬하되 “지금은 네 일 먼저 끝내고, 그 다음 도와주자”로 순서를 정해주는 것이 좋습니다. 모둠에서는 ‘도움 주기’ 역할을 시간 제한으로 운영하고(3분 설명 후 종료), 나머지 시간은 본인 과제로 돌아오게 하면 소진이 줄어듭니다. 관계로 흔들릴 때는 3-3-3 루틴 후 ‘다음 한 행동’으로 복귀시키는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_36_자기정서조절_타인공감능력'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_37_스마트폰 의존_타인정서인식'}) SET n += {lpa_class: '정서조절 취약형', x: '스마트폰 의존', z: '타인정서인식', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '스마트폰 의존이 높고 타인정서인식이 민감하면, ‘친구 반응/선생님 표정’에 흔들리며 불안이 올라가는 순간 폰으로 도피하기 쉬워 성취가 떨어질 수 있습니다. 정서조절 취약형은 눈치가 많을수록 감정이 빨리 올라오고, 그 감정이 곧바로 회피 행동으로 이어지기 쉽습니다. 따라서 타인 반응을 ‘학습 신호’가 아니라 ‘확인 질문’으로 바꾸고, 폰은 물리적으로 통제하는 접근이 필요합니다.', strategy: '수업/자습 시간에는 폰을 보관함에 넣고 “10분 후 2분 허용”처럼 예측 가능한 규칙을 고정하는 것이 좋습니다. 타인 반응에 흔들릴 때는 “지금 표정은 추측하지 말고, 확인 질문으로 바꾸자”라고 말하며 “선생님, 지금 제가 맞게 가고 있나요?” 같은 문장을 연습시키는 것이 효과적입니다. 폰 없이 10분을 버틴 날은 체크로 남기고, 주 3회 달성을 목표로 강화하면 지속이 올라갑니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_37_스마트폰 의존_타인정서인식'};
MERGE (n:ModerationPath {id: 'MOD_정서조절 취약형_38_자아존중감_활기'}) SET n += {lpa_class: '정서조절 취약형', x: '자아존중감', z: '활기', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '자아존중감과 활기가 있어도, 정서조절 취약형에서는 활기가 과열되면 실수에 대한 수치심이 커져 성취가 떨어질 수 있습니다. 중학생은 감정의 기복이 행동의 기복으로 이어지기 쉬워, 에너지가 높아도 방향이 중요합니다. 따라서 활기를 ‘짧은 몰입+끝맺음’으로 고정해 안정적으로 쓰는 것이 필요합니다.', strategy: '활기가 올라온 순간을 5분 몰입 과제로 바로 연결하고, “5분만 하고 끝내자”로 규칙을 고정하는 것이 좋습니다. 마무리는 정리 3줄로 고정해 산만함을 줄이고, 실수가 나와도 공개 지적 대신 개인 피드백으로 수치심을 낮춥니다. 끝맺음을 반복해 ‘흥분→탈진’ 패턴을 줄이는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_정서조절 취약형_38_자아존중감_활기'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_1_부모 학업지지_게임 과몰입'}) SET n += {lpa_class: '자기주도 몰입형', x: '부모 학업지지', z: '게임 과몰입', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '부모 학업지지가 있고 게임 과몰입이 있는 경우, 지지가 조절 동력이 되면 성취가 올라갈 수 있습니다. 자기주도 몰입형은 목표의식이 있는 편이라, 지지가 통제가 아니라 ‘독립적 시도’ 격려로 제공될 때 변화가 빠릅니다. 따라서 게임은 줄이기, 학습은 짧게 성공시키는 방식으로 설계하는 것이 필요합니다.', strategy: '“네가 스스로 줄이는 시도를 하는 게 중요하다”로 독립적 시도를 인정해 주는 것이 좋습니다. 게임은 주당 -30분 목표로 시작하고, 학습은 10분 1세트 성공 후 종료해 과부하를 막습니다. 성공한 날은 “오늘은 여기까지면 충분하다”로 마무리해 긍정 경험을 누적시키는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_1_부모 학업지지_게임 과몰입'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_2_시간관리_계획능력'}) SET n += {lpa_class: '자기주도 몰입형', x: '시간관리', z: '계획능력', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '시간관리가 좋을수록 계획능력도 함께 좋은 경향이 있습니다. 자기주도 몰입형은 계획을 세우면 실행도 잘 붙는 편이지만, 하고 싶은 게 많아지면 계획이 과해져 피로가 누적될 수 있습니다. 핵심은 ‘많이 하는 계획’이 아니라 ‘가능한 계획’으로 줄이는 것입니다.', strategy: '“오늘 계획 3개 규칙(필수1+중요1+선택1)”으로 제한합니다. 시간은 블록(20분/10분)으로만 잡고, 계획 끝에는 ‘첫 행동 1개’를 적게 합니다. 마감 5분(오답표시/정리3줄/내일1개)을 계획에 반드시 포함시키게 해 과부하를 막습니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_2_시간관리_계획능력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_3_공부부담_고갈'}) SET n += {lpa_class: '자기주도 몰입형', x: '공부부담', z: '고갈', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '공부부담이 커질수록 고갈(에너지 소진)도 함께 나타나기 쉽습니다. 자기주도 몰입형이라도 압박이 누적되면 몰입이 ‘버티기’로 바뀌고 회복이 늦어지면서 성취가 떨어질 수 있습니다. 그래서 부담이 큰 주에는 ‘회복 포함 루틴’이 필수입니다.', strategy: '부담이 큰 주는 목표를 축소하고 회복을 포함합니다(10분 1~2세트+휴식+마무리 3줄). 성공하면 즉시 종료해 과부하를 막고, 다음 날 같은 시간에 반복합니다. 수면/리듬 점검을 먼저 하고, 학습은 ‘재진입 성공’만 남기는 것이 효과적입니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_3_공부부담_고갈'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_4_성적부담_공부부담'}) SET n += {lpa_class: '자기주도 몰입형', x: '성적부담', z: '공부부담', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '성적부담과 공부부담이 함께 크면, 자기주도 몰입형이라도 몰입이 ‘버티기’로 바뀌어 성취가 떨어질 수 있습니다. 부담이 커질수록 정서 에너지가 소모되어 효율이 낮아집니다. 따라서 부담을 줄이고 짧은 성공을 반복해 회복을 포함한 루틴으로 돌리는 것이 필요합니다.', strategy: '준비는 10분 단위로 자르고 하루 최대 2세트로 제한해 과부하를 막는 것이 좋습니다. 오답은 2개만 고르고 다음 규칙 1개로 끝내며, “여기까지면 충분하다”로 종료를 보장합니다. 부담이 큰 주는 5분 재진입만 성공시키고 회복을 우선하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_4_성적부담_공부부담'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_5_계획능력_공부환경'}) SET n += {lpa_class: '자기주도 몰입형', x: '계획능력', z: '공부환경', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '계획능력이 좋을수록 공부환경도 함께 잘 갖추는 경향이 있습니다. 이 유형은 환경이 세팅되면 몰입이 크게 올라가므로, 환경을 ‘의지 보조장치’로 쓰면 성과가 안정적으로 유지됩니다. 다만 환경 준비가 길어져 시작이 늦어질 수 있어 ‘2분 컷’이 중요합니다.', strategy: '“2분 환경 세팅” 체크리스트(책상 비우기/필요물 3개/타이머/폰 보관)로 시작을 고정합니다. 세팅이 길어지면 “세팅 중단→첫 문제 1개”로 즉시 전환합니다. “환경은 준비가 아니라 시작 버튼”이라는 문장을 교실 공용어로 만듭니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_5_계획능력_공부환경'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_6_유능성_관계성'}) SET n += {lpa_class: '자기주도 몰입형', x: '유능성', z: '관계성', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '유능성과 관계성이 함께 높아도, 자기주도 몰입형에서는 ‘주변 기대’가 커지며 과제를 과하게 떠안으면 성취가 떨어질 수 있습니다. 유능한 학생일수록 친구가 기대고, 관계가 좋아서 더 맡아주려다 본인 공부의 깊이가 얕아질 수 있습니다. 따라서 유능성은 ‘도움 확대’가 아니라 ‘내 학습의 안정’으로 쓰고, 관계에서는 역할의 경계를 세우는 것이 필요합니다.', strategy: '모둠에서는 ‘도움 주기’를 하되 “설명은 3분만, 이후 각자 과제로 돌아오기”처럼 시간 제한을 두는 것이 좋습니다. “네가 다 해주면 친구는 편하지만, 너의 성취는 줄어듭니다. 핵심만 정리해주면 충분하다”처럼 역할의 범위를 줄여줍니다. 본인 과제는 ‘기본 유형 1개 성공’으로 고정하고, 남는 시간에만 협력을 배치하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_6_유능성_관계성'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_7_성적부담_교사 성적압력'}) SET n += {lpa_class: '자기주도 몰입형', x: '성적부담', z: '교사 성적압력', y: '학업성취도', path_type: '부정 강화', path_color: '#C0392B', interpretation: '성적부담과 교사 성적압력 신호가 낮아 보여도, 평가 자극이 강해질 때 자기주도 몰입형의 성취가 흔들릴 수 있습니다. 평가가 중심이 되면 몰입이 점수 편향으로 바뀌고 감정 소모가 커질 수 있습니다. 따라서 성적보다 과정과 전략 피드백을 고정하는 것이 필요합니다.', strategy: '평가 직전에는 “점수 목표” 대신 “오답 줄이는 규칙 1개”만 정하게 하는 것이 좋습니다. “이번 단원에서 네가 바꾼 전략 1개가 뭐냐”를 묻고, 그 전략을 칭찬해 과정 중심으로 정렬합니다. 시험 후에는 오답 2개만 처리하고 종료해 과부하를 막는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_7_성적부담_교사 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_8_타인정서인식_교사 수업부담'}) SET n += {lpa_class: '자기주도 몰입형', x: '타인정서인식', z: '교사 수업부담', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '타인정서인식이 민감한 학생은 교사 수업부담 신호를 크게 해석해 성취가 떨어질 수 있습니다. 중학생은 교사의 속도·과제량을 ‘평가’로 받아들이기 쉬워 눈치와 부담이 결합하면 실행이 늦어집니다. 따라서 과제량을 줄이고 긍정 신호를 명확히 제공하는 것이 필요합니다.', strategy: '과제는 “오늘은 핵심 1개만”으로 줄이고 “연습이다”를 먼저 선언하는 것이 좋습니다. 시도 순간 긍정 신호를 보내고, 수업 후 해석을 명시해 불필요한 추측을 줄입니다. 끝맺음 기준을 주어 과부하를 막는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_8_타인정서인식_교사 수업부담'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_9_의미감_교사 정서지지'}) SET n += {lpa_class: '자기주도 몰입형', x: '의미감', z: '교사 정서지지', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '의미감과 교사 정서지지가 함께 높아도, 자기주도 몰입형에서는 ‘더 의미 있게 해야 한다’가 부담으로 커지면 성취가 떨어질 수 있습니다. 중학생은 진로·미래 연결이 강할수록 완벽주의가 붙기 쉬워, 지지가 ‘더 하자’로 해석되면 과부하가 생깁니다. 따라서 의미는 짧게 확인하고, 지지는 ‘끝맺음 보장’으로 제공하는 것이 필요합니다.', strategy: '의미는 “이 과목이 네 목표에 주는 이득 1개”만 확인하고 바로 5분 행동으로 연결하는 것이 좋습니다. “의미가 크니까 더 해야 한다”가 아니라 “의미가 크니까 오늘은 10분만 정확히 하자”로 단위를 줄여줍니다. 마무리에서는 “여기까지면 충분하다”로 종료를 보장해 과부하를 막는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_9_의미감_교사 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_10_계획능력_노트하기'}) SET n += {lpa_class: '자기주도 몰입형', x: '계획능력', z: '노트하기', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '계획능력이 좋을수록 노트하기도 함께 잘하는 경향이 있습니다. 자기주도 몰입형은 정리/구조화가 강점이지만, 노트가 ‘정리 자체’가 되면 효율이 떨어질 수 있습니다. 노트는 반드시 적용(문제/설명)으로 연결되어야 성취로 이어집니다.', strategy: '노트는 “7분 타이머+핵심 3줄+예시 1개”로 제한하고, 바로 문제 1개 적용으로 연결합니다. “예쁘게”가 아니라 “내일 이걸 보고 풀 수 있게”를 목표로 잡습니다. 노트 후 못 풀리면 ‘노트 수정’으로 되돌리는 규칙을 줍니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_10_계획능력_노트하기'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_11_시간관리_몰두'}) SET n += {lpa_class: '자기주도 몰입형', x: '시간관리', z: '몰두', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '시간관리가 높고 몰두가 강해도, 자기주도 몰입형에서는 몰두가 길어지며 휴식이 줄어 성취가 떨어질 수 있습니다. 시간관리가 ‘더 오래’가 되면 리듬이 깨지고 다음 날 효율이 떨어질 수 있습니다. 따라서 시간관리는 종료 기준과 회복을 포함해 운영하는 것이 필요합니다.', strategy: '타이머는 ‘집중-휴식’ 세트로만 운영하고, 하루 최대 2세트로 제한하는 것이 좋습니다. 몰두가 길어지려 하면 “지금 멈추는 것도 전략이다”로 중단을 허용해 리듬을 지킵니다. 마무리는 정리 3줄로 고정하고 다음 날 같은 시간에 반복하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_11_시간관리_몰두'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_12_계획능력_무능감'}) SET n += {lpa_class: '자기주도 몰입형', x: '계획능력', z: '무능감', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '계획능력이 있어도 무능감이 커지면 계획이 실행으로 이어지지 못해 성취가 떨어질 수 있습니다. 자기주도 몰입형은 원래 계획을 잘 세우지만, 무능감이 올라오면 ‘계획만 하고 미루기’로 바뀌는 구간이 생깁니다. 따라서 계획을 더 세우기보다 ‘성공률 높은 10분 실행’으로 연결하는 것이 필요합니다.', strategy: '계획은 ‘오늘 10분짜리 1개’만 남기고 바로 실행하는 것이 좋습니다. “지금은 계획을 더 세우지 말고, 가장 쉬운 문제 1개부터 하자”처럼 성공률 높은 시작점을 제시합니다. 성공하면 즉시 종료해 ‘해냈다’ 경험을 남기고, 다음 날 같은 시간에 반복하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_12_계획능력_무능감'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_13_의미감_반감-냉소'}) SET n += {lpa_class: '자기주도 몰입형', x: '의미감', z: '반감-냉소', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '의미감이 있어도 반감·냉소가 강하면 의미가 행동으로 이어지지 못해 성취가 떨어질 수 있습니다. 냉소는 ‘해볼 이유’를 약하게 만들기 때문에 설득만으로는 실행이 붙기 어렵습니다. 따라서 의미는 짧게, 냉소는 방법 바꾸기 실험으로 전환시키는 것이 필요합니다.', strategy: '이유를 길게 말하지 말고 “너에게 이득 1개”만 확인하는 것이 좋습니다. 그 다음에는 “좋습니다, 2분만 해보고 끝내자”로 바로 행동을 붙여 실행을 만듭니다. 냉소에는 “그럼 방법을 바꿔보자” 선택지 2개로 5분 실험을 제시하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_13_의미감_반감-냉소'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_14_수업부담_부모 공부부담'}) SET n += {lpa_class: '자기주도 몰입형', x: '수업부담', z: '부모 공부부담', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '수업부담과 부모 공부부담이 함께 크면, 자기주도 몰입형도 지속적으로 긴장을 유지하며 성취가 떨어질 수 있습니다. 중학생은 압박이 양쪽에서 들어오면 정서 소모가 커지고 자율성이 흔들릴 수 있습니다. 따라서 학교-가정 모두에서 부담을 낮추고 최소 목표로 재진입을 만드는 것이 필요합니다.', strategy: '수업에서는 “핵심 1개만 정확히 잡고 끝내자”로 목표를 축소하는 것이 좋습니다. 가정에는 결과 질문을 줄이고 “오늘 한 것 한 줄만 듣기”로 바꾸도록 안내해 압박을 낮춥니다. 압박이 큰 기간에는 ‘짧게 성공 후 종료’ 원칙을 일관되게 유지하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_14_수업부담_부모 공부부담'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_15_성장마인드셋_부모 성적압력'}) SET n += {lpa_class: '자기주도 몰입형', x: '성장마인드셋', z: '부모 성적압력', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '성장마인드셋이 있어도 부모 성적압력이 크면, 신념이 ‘더 해야 한다’로 변해 과부하가 생기고 성취가 떨어질 수 있습니다. 중학생은 진로·미래 불안이 커지는 시기라 압박이 높으면 소진이 빠를 수 있습니다. 따라서 성장 관점은 ‘방법 바꾸기’로만 사용하고, 요구량은 줄이는 것이 필요합니다.', strategy: '“그럼 방법을 바꿔보자”를 쓰되 선택지는 2개만 주고 5분 실험 후 종료하는 것이 좋습니다. 가정에는 결과 질문을 줄이고 “오늘 한 노력 1개”만 듣는 규칙을 안내해 압박을 낮춥니다. 성취는 ‘짧게 성공하고 반복’으로 쌓는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_15_성장마인드셋_부모 성적압력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_16_시간관리_부모 의사소통'}) SET n += {lpa_class: '자기주도 몰입형', x: '시간관리', z: '부모 의사소통', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '시간관리와 부모 의사소통이 함께 높아도, 자기주도 몰입형에서는 대화가 잦아지며 ‘관리 받는 느낌’이 커지면 성취가 떨어질 수 있습니다. 중학생은 자율성 욕구가 커서, 좋은 의사소통도 통제로 느끼는 순간 반발이나 피로가 생길 수 있습니다. 따라서 대화는 짧게, 시간관리는 루틴 확인 수준으로만 유지하는 것이 필요합니다.', strategy: '대화 빈도를 주 2–3회로 제한하고, 5분 안에 끝내 “길게 말하지 않기” 규칙을 두는 것이 좋습니다. “오늘 타이머 한 번 했니?”처럼 확인 질문만 쓰고, “좋습니다, 그걸로 충분하다”로 마무리하면 자율성이 유지됩니다. 학생이 스스로 “오늘은 여기까지”를 말하도록 하고, 그 말을 존중해 종료를 보장하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_16_시간관리_부모 의사소통'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_17_게임 과몰입_부모 학업지지'}) SET n += {lpa_class: '자기주도 몰입형', x: '게임 과몰입', z: '부모 학업지지', y: '학업성취도', path_type: '촉진', path_color: '#3498DB', interpretation: '게임 과몰입이 있어도 부모 학업지지가 있으면, 줄이기 과정에서 정서적 지지가 안정판이 되어 성취가 올라갈 수 있습니다. 자기주도 몰입형은 스스로 조절하려는 힘이 있으므로, 지지가 통제가 아니라 과정 인정으로 제공되면 변화가 촉진됩니다. 따라서 끊기보다 줄이기 계약과 짧은 학습 성공을 함께 설계하는 것이 필요합니다.', strategy: '게임은 끊기보다 주당 -30분 같은 줄이기 목표로 시작하는 것이 좋습니다. “10분 집중하면 5분 쉬어도 된다”처럼 예측 가능한 규칙을 주고, 성공하면 “잘했다, 오늘은 여기까지”로 종료를 보장합니다. 가정에서는 결과 대신 “오늘 조절한 순간 1개”만 묻도록 하면 지지가 지속으로 이어집니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_17_게임 과몰입_부모 학업지지'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_18_부모 성적압력_성장마인드셋'}) SET n += {lpa_class: '자기주도 몰입형', x: '부모 성적압력', z: '성장마인드셋', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '부모 성적압력이 있는 환경에서는 성장마인드셋이 있어도 압박이 신념을 무력화해 성취가 떨어질 수 있습니다. 중학생은 ‘잘해야 인정받는다’로 해석하기 쉬워, 실패를 학습으로 보지 못하게 됩니다. 따라서 성장 언어를 ‘과정 인정’으로 지지하고 성적 대화는 최소화하는 것이 필요합니다.', strategy: '가정 대화는 점수 대신 “이번에 바꾼 전략 1개”만 묻도록 안내하는 것이 좋습니다. “노력=성장”을 말로만 하지 말고 ‘오답 2개→규칙 1개’처럼 구체 행동으로 연결해 주면 신념이 유지됩니다. 성적 언급이 늘어나면 주 2–3회로 줄이고 짧게 끝내는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_18_부모 성적압력_성장마인드셋'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_19_공부부담_성적부담'}) SET n += {lpa_class: '자기주도 몰입형', x: '공부부담', z: '성적부담', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '공부부담과 성적부담이 함께 커지면, 자기주도 몰입형이라도 압박이 누적되어 성취가 떨어질 수 있습니다. 중학생은 평가가 잦아 부담이 누적되면 회복이 늦어질 수 있습니다. 따라서 부담을 줄이고 최소 목표로 재진입을 설계하는 것이 필요합니다.', strategy: '“오늘은 1유형만, 10분만”처럼 목표를 축소하고 성공하면 즉시 종료하는 것이 좋습니다. 성적 대화는 오답 2개와 다음 규칙 1개로 제한해 압박을 줄입니다. 회복이 필요한 주는 수면/리듬을 먼저 점검하고, 학습은 5분 재진입만 남기는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_19_공부부담_성적부담'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_20_부모 공부부담_수업부담'}) SET n += {lpa_class: '자기주도 몰입형', x: '부모 공부부담', z: '수업부담', y: '학업성취도', path_type: '부정 완충', path_color: '#9B59B6', interpretation: '부모 공부부담과 수업부담이 함께 크면, 자기주도 몰입형도 ‘계속 평가받는 느낌’으로 피로가 누적되어 성취가 떨어질 수 있습니다. 중학생은 자율성 욕구가 커서 통제로 느끼는 순간 반발이나 회피가 생기기도 합니다. 따라서 학교에서는 부담을 완충하고, 가정에서는 역할 제한으로 압박을 낮추는 것이 필요합니다.', strategy: '학교에서는 “연습입니다, 오늘은 2문제만”으로 과제량을 줄이고 안전한 실패를 허용하는 것이 좋습니다. 가정에는 “조언 금지, 질문만”과 “오늘 한 것 한 줄만 듣기” 규칙을 안내해 압박을 낮춥니다. 학생이 “오늘은 여기까지”를 말하면 그 종료를 존중하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_20_부모 공부부담_수업부담'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_21_자기정서조절_수업태도'}) SET n += {lpa_class: '자기주도 몰입형', x: '자기정서조절', z: '수업태도', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '자기정서조절이 높고 수업태도도 좋으면, 평가 상황에서도 회복이 빨라 성취가 올라가는 상태입니다. 자기주도 몰입형은 몰입이 강한 만큼 작은 실패에 민감해질 수 있는데, 조절 능력이 있으면 다시 과제로 돌아오는 속도가 빨라집니다. 따라서 ‘회복→재시작’ 루틴을 계속 강화하는 것이 필요합니다.', strategy: '실수나 막힘이 생길 때 “여기까지는 맞았다, 다음 한 단계만 가자”처럼 부분 성공을 먼저 확인해 주는 것이 좋습니다. 조절 행동이 보이면 “멈추고 다시 시작했네, 그게 실력이다”로 명명해 주면 습관이 됩니다. 수업 후에는 ‘오늘 막힌 1개-내일 바꿀 1개’만 정리해 재시작을 가볍게 만드는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_21_자기정서조절_수업태도'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_22_의미감_스마트폰 의존'}) SET n += {lpa_class: '자기주도 몰입형', x: '의미감', z: '스마트폰 의존', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '의미감이 있어도 스마트폰 의존이 높으면 실행이 자주 끊겨 성취가 떨어질 수 있습니다. 의미가 크면 ‘해야 한다’는 부담이 올라가고, 그 순간 폰이 회피 수단이 되기 쉽습니다. 따라서 환경 통제와 짧은 성공 경험을 함께 설계하는 것이 필요합니다.', strategy: '폰은 물리적으로 보관하고, “10분 집중 후 2분 허용” 규칙을 고정하는 것이 좋습니다. 의미는 “너에게 이득 1개”만 확인하고 “그럼 5분만 하고 끝내자”로 행동 단위를 붙입니다. 폰 없이 성공한 날은 체크로 남겨 주 3회 달성을 목표로 강화하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_22_의미감_스마트폰 의존'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_23_몰두_시간관리'}) SET n += {lpa_class: '자기주도 몰입형', x: '몰두', z: '시간관리', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '몰두와 시간관리가 함께 높아도, 자기주도 몰입형에서는 과하게 몰입을 유지하려다 휴식이 줄어 성취가 떨어질 수 있습니다. 중학생은 리듬이 깨지면 집중이 급격히 무너질 수 있어, 시간관리가 ‘더 하기’가 되면 역효과가 납니다. 따라서 몰두는 짧게, 시간관리는 종료 기준까지 포함해 운영하는 것이 필요합니다.', strategy: '‘10-2’처럼 휴식이 포함된 타이머를 쓰고, 하루 최대 2세트까지만 허용하는 것이 좋습니다. “지금 멈추는 것도 전략이다”를 반복해 휴식을 기술로 인정해 주면 과부하가 줄어듭니다. 마무리는 ‘정리 3줄’로 고정해 끝맺음을 만들고, 다음 날 같은 시간에 반복하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_23_몰두_시간관리'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_24_반감-냉소_시험준비'}) SET n += {lpa_class: '자기주도 몰입형', x: '반감-냉소', z: '시험준비', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '반감·냉소가 높을수록 시험준비가 ‘의미 찾기’가 아니라 ‘통과/버티기’로 굳어지며 함께 나타날 수 있습니다. 자기주도 몰입형도 피로가 누적되면 냉소가 올라올 수 있으니, 감정은 건드리기보다 준비 행동을 망치지 않게 구조화하는 게 먼저입니다.', strategy: '감정과 행동을 분리합니다. “지금은 의미보다 통과를 위한 준비”로 프레임을 주고, 준비는 20분+마무리 5분(오답표시/규칙1개/내일1개)로 고정합니다. 냉소가 올라오면 분량을 줄여도 ‘마무리만은 완료’하게 하고 “싫어도 준비를 유지한 게 실력”으로 행동을 인정합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_24_반감-냉소_시험준비'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_25_관계성_유능성'}) SET n += {lpa_class: '자기주도 몰입형', x: '관계성', z: '유능성', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '관계성과 유능성이 함께 높아도, 자기주도 몰입형에서는 ‘기대 역할’이 커져 과제를 과하게 떠안으면 성취가 떨어질 수 있습니다. 유능한 학생일수록 친구가 기대고, 그 기대가 누적되면 정작 본인 과제의 깊이가 떨어질 수 있습니다. 따라서 유능성은 ‘도전 확대’가 아니라 ‘기본기 안정’으로 쓰고, 관계에서는 역할을 제한하는 것이 필요합니다.', strategy: '모둠에서는 ‘도움 주기’를 역할로 주되 시간 제한(3분 설명 후 종료)을 두는 것이 좋습니다. “너는 잘하니까 다 해”가 아니라 “네가 핵심만 정리해주면 충분하다”처럼 역할의 범위를 줄여줍니다. 본인 과제는 ‘기본 유형 1개 성공’으로 고정해 성취를 안정적으로 쌓는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_25_관계성_유능성'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_26_공부부담_의미감'}) SET n += {lpa_class: '자기주도 몰입형', x: '공부부담', z: '의미감', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '공부부담이 큰 상태에서 의미감이 높아도, 의미가 ‘더 해야 한다’로 변하면 압박이 커져 성취가 떨어질 수 있습니다. 중학생은 진로 연결이 동기가 되지만, 부담이 큰 시기에는 그 연결이 오히려 불안을 키울 수 있습니다. 따라서 의미는 짧게 확인하고, 부담은 줄여 최소 행동으로 연결하는 것이 필요합니다.', strategy: '의미는 “너에게 이득 1개”만 확인하고 “그래서 오늘은 5분만 하고 끝내자”로 단위를 함께 제시하는 것이 좋습니다. 부담이 큰 주에는 준비량을 줄이고 오답 1개만 정리해 종료를 보장합니다. 의미를 이유로 요구를 늘리지 않고, ‘짧게 끝내고 반복’으로 리듬을 만드는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_26_공부부담_의미감'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_27_계획능력_자기정서인식'}) SET n += {lpa_class: '자기주도 몰입형', x: '계획능력', z: '자기정서인식', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '계획능력과 자기정서인식이 함께 높아도, 자기주도 몰입형에서는 ‘상태 점검’이 과해져 실행이 느려지고 성취가 떨어질 수 있습니다. 중학생은 불안이 올라오면 ‘계획을 다시 세우기’로 회피하기도 하므로, 정서 인식이 행동으로 연결되지 않으면 분산이 커집니다. 따라서 감정 점검은 짧게, 계획은 즉시 실행으로 연결하는 것이 필요합니다.', strategy: '감정 점검은 10초로 끝내고 “그럼 다음 행동 1개만 하자”로 바로 전환하는 것이 좋습니다. 계획은 ‘10분 단위 1개’만 정하고, 끝나면 바로 종료해 ‘다시 계획 세우기’ 반복을 막습니다. “지금은 느낌 분석보다 10분 실행이 먼저다” 같은 문장을 고정해 주면 실행이 붙습니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_27_계획능력_자기정서인식'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_28_수업태도_자기정서조절'}) SET n += {lpa_class: '자기주도 몰입형', x: '수업태도', z: '자기정서조절', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '수업태도가 좋고 자기정서조절이 함께 높으면, 긴장 상황에서도 흔들림이 적어 성취가 올라가는 상태입니다. 자기주도 몰입형은 과제 수행력이 높은 편인데, 정서조절이 붙으면 시험·발표 같은 평가 상황에서도 몰입을 유지하기 쉽습니다. 따라서 태도를 ‘꾸준한 실행’으로 유지시키는 루틴을 강화하는 것이 필요합니다.', strategy: '수업 참여를 ‘완벽’이 아니라 ‘지속’으로 정의해 주는 것이 좋습니다. 예를 들어 “오늘은 끝까지 듣고 핵심 3줄만 남기면 충분하다”처럼 마무리 기준을 주면 안정적으로 이어집니다. 감정이 올라오는 순간에는 3-3-3(멈춤-호흡-재시작) 후 ‘다음 한 단계’만 제시해 흐름을 끊지 않게 하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_28_수업태도_자기정서조절'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_29_유능성_자기효능감'}) SET n += {lpa_class: '자기주도 몰입형', x: '유능성', z: '자기효능감', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '유능성이 높을수록 자기효능감도 함께 높게 유지되는 경향이 있습니다. 이 유형은 잘하는 만큼 도전이 붙지만, 평가 시즌에 흔들리면 “원래 잘하는데 왜 안 되지”로 효능감 낙폭이 커질 수 있습니다. 그래서 성취를 ‘완벽’이 아니라 ‘유지할 루틴’으로 관리해야 합니다.', strategy: '평가 전에는 “오늘 목표는 완벽이 아니라 루틴 유지”로 기준을 바꿉니다(10분 2세트+마무리 3줄). 잘하는 학생일수록 ‘도전 3문제’처럼 범위를 좁혀 성공을 고정합니다. 효능감은 결과보다 “계획대로 끝맺었다” 같은 규칙 준수로 칭찬해 낙폭을 줄입니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_29_유능성_자기효능감'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_30_자기효능감_자아존중감'}) SET n += {lpa_class: '자기주도 몰입형', x: '자기효능감', z: '자아존중감', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '자기효능감이 높을수록 자아존중감도 함께 안정적인 경향이 있습니다. 자기주도 몰입형은 기본 자원이 좋아 “나는 할 수 있다”와 “나는 괜찮은 사람이다”가 함께 굴러가지만, 성취 기준이 올라가면 작은 실수에도 자기평가가 흔들릴 수 있습니다. 그래서 칭찬을 ‘사람’이 아니라 ‘과정/전략 증거’에 붙여 안정적으로 유지시키는 게 중요합니다.', strategy: '“너 대단해” 대신 “오답을 왜 틀렸는지 설명한 게 실력”처럼 증거 칭찬을 줍니다. 실패가 나와도 “너”가 아니라 “방법”을 바꾸는 피드백(전략 수정)으로 자존감 손상을 막습니다. 주 1회 ‘이번 주 성장 증거 3개(전략/설명/복습)’ 체크로 자존감-효능감을 건강하게 연결합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_30_자기효능감_자아존중감'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_31_자기효능감_자율성'}) SET n += {lpa_class: '자기주도 몰입형', x: '자기효능감', z: '자율성', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '자기효능감이 높을수록 자율성도 함께 높은 경향이 있습니다. 자기주도 몰입형은 주도적으로 잘하지만, 선택지가 너무 많아지면 오히려 부담(내가 다 책임져야 함)이 커져 멈출 수 있습니다. 자율성은 ‘작은 선택’으로 제한하고 구조는 강하게 주는 것이 안정적입니다.', strategy: '선택은 “A/B 중 뭐 먼저?”처럼 2개로 제한합니다. 선택 후에는 “네가 정한 것만 끝내면 된다”로 책임 범위를 줄입니다. 흔들리는 날엔 선택을 줄이고 ‘5분만’으로 구조를 강화해 재진입을 돕습니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_31_자기효능감_자율성'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_32_시간관리_점검능력'}) SET n += {lpa_class: '자기주도 몰입형', x: '시간관리', z: '점검능력', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '시간관리가 좋을수록 점검능력도 함께 좋은 경향이 있습니다. 이 유형은 진행을 확인하면 시간 배분이 더 정교해져 성과가 안정적이지만, 점검이 과해지면 실행 시간이 줄 수 있습니다. 점검은 ‘짧고 정해진 순간’에만 두는 것이 핵심입니다.', strategy: '점검을 “끝나고 3분(완료/오답1/다음1)”으로 제한하고 중간 점검은 1회만 허용합니다. 점검이 끝나면 “다음 문제 1개 시작”으로 자동 연결합니다. 교사는 “점검은 공부가 아니라 마무리 기술”이라고 말해 점검 과잉을 막습니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_32_시간관리_점검능력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_33_부모 학업지지_조절능력'}) SET n += {lpa_class: '자기주도 몰입형', x: '부모 학업지지', z: '조절능력', y: '학업성취도', path_type: '긍정 강화', path_color: '#2ECC71', interpretation: '부모의 학업지지가 있고 조절능력이 높으면, 자율적으로 공부하는 흐름이 끊기지 않아 성취가 올라가는 상태입니다. 자기주도 몰입형은 스스로 방향을 잡을 수 있지만, 시험·과제 시즌에는 변수가 늘어 조절 루틴이 필요합니다. 따라서 지지는 통제가 아니라 ‘과정 인정’으로, 조절은 ‘루틴’으로 굳히는 것이 필요합니다.', strategy: '가정에서는 결과 대신 과정 질문 2개(“오늘 무엇을 했어?” “내일은 무엇을 유지할래?”)만 쓰게 하는 것이 좋습니다. 조절은 ‘10분 집중-2분 휴식’처럼 리듬으로 고정하고, “네가 스스로 멈추고 다시 시작한 게 실력이다”처럼 조절 행동을 구체적으로 인정해 주면 지속이 올라갑니다. 진로 연결은 길게 하지 말고 “지금 하는 이 연습이 네 목표에 어떤 도움인지 1개만” 확인하는 정도로 유지하는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_33_부모 학업지지_조절능력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_34_교사 성적압력_친구 공부비교'}) SET n += {lpa_class: '자기주도 몰입형', x: '교사 성적압력', z: '친구 공부비교', y: '학업성취도', path_type: '부정 강화', path_color: '#C0392B', interpretation: '교사 성적압력 신호와 친구 공부비교가 낮아도, 비교가 등장하는 순간 자기주도 몰입형의 성취가 흔들릴 수 있습니다. 중학생은 비교가 강한 환경에서 몰입이 경쟁으로 바뀌면 정서 소모가 커집니다. 따라서 비교 대화를 차단하고 자기준거 기준을 고정하는 것이 필요합니다.', strategy: '비교 발언이 나오면 “친구 말고 어제의 나와 비교하자”로 즉시 프레임을 바꾸는 것이 좋습니다. 성과 확인은 “이번 주에 내가 유지한 것 1개”로 하고, 결과는 오답 2개만 다뤄 학습 중심으로 유지합니다. 협력은 ‘서로 점검’으로만 제한하고, 등수/점수 대화는 금지하는 것이 바람직합니다.', z_factor_type: 'negative', z_need_direction: 'higher_T_worse', id: 'MOD_자기주도 몰입형_34_교사 성적압력_친구 공부비교'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_35_유능성_친구 정서지지'}) SET n += {lpa_class: '자기주도 몰입형', x: '유능성', z: '친구 정서지지', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '유능성이 높을수록 친구 정서지지도 함께 받는 경향이 있습니다. 자기주도 몰입형은 도움을 주고받는 관계가 학습을 가속할 수 있지만, “나만 도와주고 끝”이 되면 본인 학습이 밀릴 수 있습니다. 그래서 지지는 ‘짧고 효율적인 협력’으로만 운영하는 게 좋습니다.', strategy: '도움은 “3분 설명 후 종료”로 제한하고, 이후 각자 과제로 복귀합니다. 지지를 ‘위로’가 아니라 ‘함께 1문제’로 실행화합니다. 교사는 “네가 핵심만 정리해줘도 충분하다”로 경계를 세워주고, 본인 과제(기본 유형 1개 성공)를 먼저 끝낸 뒤 도움을 주게 합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_35_유능성_친구 정서지지'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_36_성적부담_타인공감능력'}) SET n += {lpa_class: '자기주도 몰입형', x: '성적부담', z: '타인공감능력', y: '학업성취도', path_type: '억제', path_color: '#E74C3C', interpretation: '성적부담이 큰 상태에서 타인공감능력이 높으면, 관계에 쓰는 에너지가 늘어 학습이 밀려 성취가 떨어질 수 있습니다. 중학생은 또래 관계가 중심이라 공감이 강할수록 소진이 빠질 수 있습니다. 따라서 공감은 시간 제한을 둔 협력으로만 운영하는 것이 필요합니다.', strategy: '도움은 “3분 설명 후 종료”로 제한하고, 이후에는 본인 과제로 복귀하게 하는 것이 좋습니다. 성적 부담이 큰 주에는 협력 시간을 줄이고 ‘혼자 몰입 10분’부터 확보해 안정감을 만듭니다. 공감 행동은 칭찬하되 ‘경계 세우기’를 더 칭찬해 소진을 막는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_36_성적부담_타인공감능력'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_37_성장마인드셋_타인정서인식'}) SET n += {lpa_class: '자기주도 몰입형', x: '성장마인드셋', z: '타인정서인식', y: '학업성취도', path_type: '긍정 완충', path_color: '#F39C12', interpretation: '성장마인드셋이 높고 타인정서인식이 민감하면, ‘잘하고 싶다’가 커지면서 타인의 반응에 과하게 흔들려 성취가 떨어질 수 있습니다. 중학생은 또래 시선이 크게 작동하므로, 눈치가 많을수록 실행이 늦어지는 구간이 생깁니다. 따라서 타인 반응은 추측이 아니라 확인으로 바꾸고, 성장 관점은 ‘방법 바꾸기’로만 연결하는 것이 필요합니다.', strategy: '“친구 표정은 추측하지 말고 확인하자”로 전환하고, “제가 맞게 가고 있나요?” 같은 확인 질문을 연습시키는 것이 좋습니다. 성장마인드셋은 “그럼 방법을 바꿔보자” 선택지 2개로만 쓰고, 5분 실험 후 바로 종료해 과부하를 막습니다. 피드백은 타인 평가가 아니라 ‘시도-변경’ 근거로 주는 것이 바람직합니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_37_성장마인드셋_타인정서인식'};
MERGE (n:ModerationPath {id: 'MOD_자기주도 몰입형_38_몰두_활기'}) SET n += {lpa_class: '자기주도 몰입형', x: '몰두', z: '활기', y: '학업성취도', path_type: '조합', path_color: '#95A5A6', interpretation: '몰두가 높을수록 활기도 함께 높은 경향이 있습니다. 이 유형은 에너지가 학습으로 잘 전환되지만, 몰두가 길어지면 휴식이 줄어 다음 날 효율이 떨어질 수 있습니다. 몰입은 “지속 가능한 리듬”으로 관리해야 합니다.', strategy: '몰입은 10~25분 단위로 자르고 반드시 휴식을 포함합니다(10-2 또는 25-5). 하루 최대 2세트까지만 허용하고, “지금 멈추는 것도 전략”을 반복해 과몰입을 막습니다. 마무리는 정리 3줄로 고정해 끝맺음을 만듭니다.', z_factor_type: 'positive', z_need_direction: 'lower_T_worse', id: 'MOD_자기주도 몰입형_38_몰두_활기'};

