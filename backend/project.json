{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/src",
  "targets": {
    "build": {
      "command": "./gradlew :backend:build"
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\backend\\run-backend.ps1"
      }
    }
  }
}
